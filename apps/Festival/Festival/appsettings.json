{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spark": {
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "SparkFestival"
    },
    "Mail": {
      "ApplicationName": "Spark Festival",
      "From": { "Address": "noreply@festival.example", "Name": "Spark Festival demo" },
      "PickupFolder": "mail-pickup"
    },
    "Consent": {
      "PolicyVersion": "2026-10",
      "PolicyUrl": "/legal/privacy"
    },
    "Challenges": {
      // The waiting room asks a challenge at join. Turnstile with Cloudflare's published always-pass TEST keys
      // (developers.cloudflare.com/turnstile/troubleshooting/testing): not credentials, nothing real is verified.
      // A visitor who refuses the third-party-challenge purpose gets ALTCHA instead (GA9).
      "Points": [ "queue-join" ],
      "Turnstile": {
        "SiteKey": "1x00000000000000000000AA",
        "SecretKey": "1x0000000000000000000000000000000AA"
      }
    },
    "Commerce": {
      // PRD §3.2 "Festival": tickets and merchandise in one app, one basket, one payment (D40).
      "Merchant": "ConnectedSellers",
      "Country": "BE",
      "Sellers": { "Registration": "ApprovalRequired" },
      "Channels": {
        "tickets": {
          "Allocation": "HoldFromSelection",
          "Hold": { "Default": "00:10:00", "Min": "00:05:00", "Max": "00:20:00", "Extension": "00:05:00" },
          "MaxPaymentWindow": "00:30:00",
          "RequireSignIn": true,
          "PerBuyerLimit": 8,
          "WaitingRoom": { "Modes": [ "RandomizedPreQueue", "Ballot", "Fifo" ], "Default": "RandomizedPreQueue" },
          "Fees": [ { "Code": "service", "Kind": "Service", "Fixed": { "EUR": 1.50 } } ],
          "RequiredLegalDocuments": [ "terms-of-sale", "privacy-policy" ]
        },
        "shop": {
          "Allocation": "OnPayment",
          "RequireSignIn": false,
          "SellsGoods": true,
          "RequiredLegalDocuments": [ "terms-of-sale", "privacy-policy", "withdrawal-information" ]
        }
      },
      "Basket": { "MixChannels": true },
      "Legal": { "AccessibilityStatementUrl": "/legal/accessibility" },
      "Payments": {
        "Provider": "test",
        "PublicBaseUrl": "https://localhost:5015"
      },
      "Checkout": {
        "Refunds": { "TimeZone": "Europe/Brussels" }
      },
      "Shop": {
        "DefaultChannel": "shop",
        "Fulfilment": "ShopOnly"
      },
      "Shipping": {
        "Carrier": "test",
        "Currency": "EUR",
        "Sender": {
          "Name": "Spark Festival Demo Organisation",
          "Street": "Festivalweide",
          "HouseNumber": "1",
          "PostalCode": "9000",
          "City": "Gent",
          "Country": "BE",
          "Email": "shipping@festival.example"
        },
        "Zones": {
          "be": { "Countries": [ "BE" ] },
          "benelux-fr-de": { "Countries": [ "NL", "LU", "FR", "DE" ] }
        },
        "Methods": {
          "standard": { "Kind": "Carrier", "Carrier": "test", "Service": "test-standard", "Rates": { "be": 4.95, "benelux-fr-de": 9.95 }, "FreeFrom": { "be": 50 }, "TransitDays": { "Min": 1, "Max": 2 }, "Order": 1 },
          "point": { "Kind": "Carrier", "Carrier": "test", "Service": "test-point", "Rates": { "be": 3.95 }, "TransitDays": { "Min": 1, "Max": 3 }, "Order": 2 },
          "pickup": { "Kind": "Pickup", "PickupLocation": "Festival info desk", "Rates": { "be": 0 }, "Order": 3 }
        },
        "Dispatch": { "TimeZone": "Europe/Brussels" }
      },
      "Invoicing": {
        "TimeZone": "Europe/Brussels",
        "VatCategories": {
          "standard": { "Rates": { "BE": 2100, "NL": 2100, "FR": 2000, "LU": 1700, "DE": 1900 } },
          "admission": { "Kind": "Admission", "IsService": true, "Rates": { "BE": 600, "NL": 900, "FR": 550, "LU": 300, "DE": 700 } }
        },
        "Dac7": { "PlatformTin": "0000000000", "TicketChannels": [ "tickets" ] }
      },
      "Ticketing": {
        "Events": { "DefaultChannel": "tickets", "EventPagePath": "/events/{slug}" }
      }
    }
  }
}
