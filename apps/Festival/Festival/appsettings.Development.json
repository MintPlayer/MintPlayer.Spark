{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Spark": {
    "ReferenceData": {
      // apps/ReferenceData (https 5017) holds the basic seed set (BE, NL, FR, LU, DE; commerce D39). Run it beside this
      // app for the address typeahead; without it the address form stays free text.
      "Client": {
        "BaseAddress": "https://localhost:5017/",
        "Sync": { "Enabled": false }
      }
    }
  },
  "Festival": {
    // The organiser account: set Festival:Admin:Email and Festival:Admin:Password in user secrets (FestivalAdminSeeder).
    // Lets an administrator drive the test provider (disputes, refund behaviour) and create queued sales on demand
    // (POST /festival-test/*). Development and the E2E host only; refused at startup in Production.
    "TestSeams": { "Enabled": true }
  }
}
