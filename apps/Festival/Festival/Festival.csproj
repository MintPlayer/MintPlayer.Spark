<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
	  apps/Festival (commerce #521 M18, docs/commerce_PRD.md §3.2, §4.16, D22): the festival demo. One app with both
	  systems hooked up: a ticket channel and a shop channel in ConnectedSellers mode, one basket and one payment
	  (Basket:MixChannels, D40), the test payment provider, the test carrier and the test Peppol access point. Local and
	  E2E only: not deployed, no Dockerfile. https 5015 / http 5016.
	-->
