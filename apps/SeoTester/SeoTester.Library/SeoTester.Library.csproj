<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<SparkEntityLibrary>true</SparkEntityLibrary>
	</PropertyGroup>

	<ItemGroup>
		<!-- Attributes (+ Model) only, never the Web-SDK Abstractions: SPARKLIB001 fails the build if ASP.NET Core creeps in (#388).
		     The entities (Site, AuditRun, PageResult, …) arrive with M8; the check implementations with M9. -->
		<ProjectReference Include="..\..\..\libs\attributes\MintPlayer.Spark.Attributes\MintPlayer.Spark.Attributes.csproj" />
		<!-- The crawl pipeline's message types ([MessageQueue]), plain SDK. -->
		<ProjectReference Include="..\..\..\libs\messaging\MintPlayer.Spark.Messaging.Abstractions\MintPlayer.Spark.Messaging.Abstractions.csproj" />
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.LibraryGenerators\MintPlayer.Spark.LibraryGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- HTML5 parsing for the raw-HTML checks (M9, spike S9): the tree a browser builds, CSS selectors, no script
		     execution (AngleSharp runs no JavaScript without AngleSharp.Js, which is not referenced). -->
		<PackageReference Include="AngleSharp" Version="1.7.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- The shipped check catalogue (docs/seo_analyzer_PRD.md §3.1, D32): the seed of the CheckDefinition documents. -->
		<EmbeddedResource Include="Catalogue\checks.json" LogicalName="SeoTester.Catalogue.checks.json" />
		<InternalsVisibleTo Include="SeoTester.Tests" />
	</ItemGroup>

</Project>
