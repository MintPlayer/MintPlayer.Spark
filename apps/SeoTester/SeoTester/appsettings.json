{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spark": {
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "SeoTester"
    },
    "Auth": {
      // External sign-in only (docs/seo_analyzer_PRD.md D2). A provider whose ClientId is empty is not registered.
      // NEVER put a value here: the ids and secrets go in user secrets locally and in the server's environment
      // (Spark__Auth__Providers__GitHub__ClientSecret, …). docs/seotester/README.md lists what to register.
      "Providers": {
        "MicrosoftAccount": { "ClientId": "", "ClientSecret": "" },
        "GitHub": { "ClientId": "", "ClientSecret": "" },
        "Twitter": { "ClientId": "", "ClientSecret": "" },
        "Google": { "ClientId": "", "ClientSecret": "" }
      }
    },
    "Mail": {
      "ApplicationName": "SeoTester",
      "From": { "Address": "noreply@seotester.mintplayer.com", "Name": "SeoTester" }
    },
    "Notifications": {
      // VAPID keys (MintPlayer.Spark.WebPush.VapidDetails.Generate). Empty = Web Push off; in-app and mail still work.
      "WebPush": { "PublicKey": "", "PrivateKey": "", "Subject": "" }
    },
    "Messaging": {
      // The crawl pipeline (docs/seo_analyzer_PRD.md §4.3). Declared here so the subscription manager knows them
      // before their recipients exist; HandlerTimeout bounds one message (X7). The crawl batch size is chosen in
      // M9 (spike S7) to stay well under its timeout. seo-render: at most 10 pages × a 50 s page budget; seo-psi: at
      // most 5 pages × a 100 s client timeout (S5 measured 8–30 s per page): both under 10 minutes.
      "Queues": {
        "seo-probe": { "MaxConcurrency": 2, "HandlerTimeout": "00:05:00" },
        "seo-crawl": { "MaxConcurrency": 2, "HandlerTimeout": "00:10:00" },
        "seo-render": { "MaxConcurrency": 1, "HandlerTimeout": "00:10:00" },
        "seo-psi": { "MaxConcurrency": 1, "HandlerTimeout": "00:10:00" },
        "seo-aggregate": { "MaxConcurrency": 1, "HandlerTimeout": "00:10:00" },
        "seo-pdf": { "MaxConcurrency": 1, "HandlerTimeout": "00:05:00" }
      }
    }
  },
  "SeoTester": {
    // Google Cloud API key for PageSpeed Insights / CrUX (D9, D13). Empty = "not measured". A secret: never here.
    "PageSpeed": { "ApiKey": "" },
    // The headless browser (M10): Off (the rendered checks are "not measured", no PDF export), Launch (a local Chromium)
    // or Connect (the Chromium container, Endpoint = its run-server's ws:// URL). Per environment below.
    "Browser": { "Mode": "Off" }
  }
}
