{
  "Spark": {
    "Auth": {
      // Mailed links (link confirmations, invitations, notifications) and the share links are built from this.
      "PublicBaseUrl": "https://seotester.mintplayer.com"
    }
  },
  "SeoTester": {
    // The Chromium container on the seo-browser network (D3, D6; compose service and image: docs/seotester/README.md, M12).
    "Browser": { "Mode": "Connect", "Endpoint": "ws://seo-chromium:3000/" },
    // Every request to a target leaves from the seo-fetcher container on the seo-fetch network (D54); the key is the
    // shared secret SEO_FETCHER_KEY from the server's .env (SeoTester__Fetcher__Key), never in this file.
    "Fetcher": { "Mode": "Remote", "Url": "http://seo-fetcher:8080/" }
  }
}
