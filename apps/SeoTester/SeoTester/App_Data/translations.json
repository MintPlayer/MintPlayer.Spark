          "label": {
            "en": "Report language",
            "nl": "Taal van het rapport"
          }
        },
        "VerificationToken": {
          "description": {
            "en": "The secret the organization publishes to prove control; random, made at creation."
          },
          "label": {
            "en": "Verification token",
            "nl": "Verificatiecode"
          }
        },
        "IsVerified": {
