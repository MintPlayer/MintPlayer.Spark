{
  "Spark": {
    // Development sends no mail: every message is written as an .eml file into mail-pickup/.
    "Mail": {
      "PickupFolder": "mail-pickup"
    },
    // Sign in without registering any OAuth app: SparkId, the demo identity provider (run apps/SparkId with
    // --launch-profile https). Its migration M_202610101200_SeoTesterRelyingParty registers the "seotester" client
    // with redirect https://localhost:5013/signin-SparkId. The secret is a published DEVELOPMENT-ONLY value shared
    // with that migration, not a credential. Real providers go in user secrets (docs/seotester/README.md).
    "Auth": {
      "Providers": {
        "OpenIdConnect": {
          "SparkId": {
            "DisplayName": "Spark Identity",
            "Authority": "https://localhost:5011",
            "ClientId": "seotester",
            "ClientSecret": "dev-only-seotester-secret-not-for-production"
          }
        }
      }
    },
    // The MCP endpoint's canonical URL: the audience of every agent token, so the embedded authorization server refuses to
    // start without one (production derives it from Spark:Auth:PublicBaseUrl). The http profile, because Node-based agents
    // do not trust the ASP.NET development certificate (docs/guide-mcp.md, Troubleshooting).
    "Mcp": {
      "CanonicalUrl": "http://localhost:5014/mcp"
    }
  },
  // The headless browser (M10): a Chromium launched here (install it once: pwsh apps/SeoTester/SeoTester/bin/Debug/net11.0/playwright.ps1
  // install chromium). Production drives the Chromium container instead (Mode Connect, docs/seotester/README.md).
  "SeoTester": {
    "Browser": { "Mode": "Launch" }
  }
}
