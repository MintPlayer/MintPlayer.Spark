# /var/www/seotester/.env on the VPS (server-managed: deploys never write it; chmod 600).
# Every value below is a placeholder. What to register and where each comes from: docs/seotester/deploy.md.
# The public hostname is hard-coded in docker-compose.yml (Traefik Host rule) and appsettings.Production.json.

# ─── Sign-in providers (at least one, or the app refuses to start) ─────────────────────────────────
# Callbacks: https://seotester.mintplayer.com/signin-microsoft | -github | -twitter | -google
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=your_entra_client_secret
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# X: the OAuth 2.0 client id/secret, NOT the 1.0a API key/secret.
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── The fetcher (required; docs/seo_analyzer_PRD.md D54) ──────────────────────────────────────────
# The shared secret seotester-app calls seo-fetcher with: both containers read this one value. At least 32
# characters; generate once with `openssl rand -hex 32`. Changing it needs both containers recreated (a deploy does).
SEO_FETCHER_KEY=replace_with_the_output_of_openssl_rand_hex_32

# ─── Web Push (VAPID; optional: empty = push off) ──────────────────────────────────────────────────
# Generate once (docs/seotester/deploy.md "VAPID keys"). Changing the pair later drops every browser subscription.
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_PRIVATE_KEY=your_vapid_private_key_base64url
VAPID_SUBJECT=mailto:you@example.com

# ─── PageSpeed Insights / CrUX (optional: empty = "not measured") ──────────────────────────────────
PAGESPEED_API_KEY=your_google_cloud_api_key

# ─── The operator, shown on /privacy and /terms ────────────────────────────────────────────────────
# Placeholders only: the real values live in the server's .env, never in the repository. Each value appears in both the
# English and the Dutch text. Required (empty = "[to be completed]" + a startup warning): name, e-mail, hosting provider.
LEGAL_OPERATOR_NAME=Your legal name or company name
LEGAL_CONTACT_EMAIL=privacy@example.com
# Optional: only for a registered enterprise; leave both empty as a private person (they are then left out).
LEGAL_ADDRESS=Street 1, 1000 City, Belgium
LEGAL_ENTERPRISE_NUMBER=0000.000.000
# Optional: completes "disputes go to …"; empty reads "the competent Belgian courts" / "de bevoegde Belgische rechtbanken".
LEGAL_COURT=
# Completes "The server is hosted by …": the provider and the country of the data centre.
LEGAL_HOSTING_PROVIDER=<provider>, <country>

# ─── Mail (optional overrides) ─────────────────────────────────────────────────────────────────────
# Defaults: CodeCoverage's relay coverage-smtp:587, sender noreply@seotester.mintplayer.com. The relay accepts the
# sender only once seotester.mintplayer.com is in CodeCoverage's MAIL_SENDER_DOMAIN (its .env), see the runbook.
#MAIL_HOST=coverage-smtp
#MAIL_PORT=587
#MAIL_FROM_ADDRESS=noreply@seotester.mintplayer.com
#MAIL_FROM_NAME=SeoTester
