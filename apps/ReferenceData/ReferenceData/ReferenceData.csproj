<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
	  apps/ReferenceData (docs/reference_data_PRD.md §4.16, commerce M19): a reference-data instance with the basic seed
	  set, and a consumer page that uses the client packages against the instance itself. Local only (K8 revised): not
	  deployed by us, no Dockerfile.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<UserSecretsId>5f0c7a51-2b7d-4e0f-9d83-1a6c2e4b9f17</UserSecretsId>
		<SpaRoot>ClientApp\</SpaRoot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="11.0.0-rc.3" />
		<PackageReference Include="MintPlayer.SourceGenerators" Version="13.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- The basic seed set (RD9): a release written by the refdata-build-seed command and checked by refdata-verify-seed. -->
		<Content Update="Seed\**\*" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Seed\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
