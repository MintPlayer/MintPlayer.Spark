{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spark": {
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "RefData"
    },
    "ReferenceData": {
      "Sources": {
        "be-refnis":        { "Schedule": "0 30 4 * * 1", "Enabled": false },
        "be-nis6":          { "Schedule": "0 30 4 * * 1", "Enabled": false },
        "be-postalstreets": { "Schedule": "0 0 4 * * *",  "Enabled": false },
        "global-geonames":  { "Schedule": "0 0 6 * * 0",  "Enabled": false },
        "global-wikidata":  { "Schedule": "0 0 6 * * 0",  "Enabled": false },
        "global-cldr":      { "Schedule": "0 0 6 * * 0",  "Enabled": false },
        "global-tzdata":    { "Schedule": "0 0 6 * * 0",  "Enabled": false },
        "eu-tedb":          { "Schedule": "0 0 5 * * 1",  "Enabled": false },
        "statute-holidays": { "Schedule": "0 0 3 1 1 *",  "Enabled": false }
      },
      "Seed": { "Enabled": true, "Directory": "Seed" }
    }
  }
}
