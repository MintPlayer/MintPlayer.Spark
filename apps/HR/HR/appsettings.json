{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spark": {
    "Mail": {
      "ApplicationName": "Spark HR",
      "From": { "Address": "noreply@hr.example", "Name": "Spark HR demo" },
      "PickupFolder": "mail-pickup"
    },
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
