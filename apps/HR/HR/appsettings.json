    },
    "Replication": {
      "ModuleName": "HR",
      "ModuleUrl": "https://localhost:5005",
      "SparkModulesUrls": [ "http://localhost:8080" ],
      "SparkModulesDatabase": "SparkModules"
    }
  }
}
