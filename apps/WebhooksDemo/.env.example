GITHUB_WEBHOOK_SECRET=whsec_your_webhook_secret
GITHUB_APP_CLIENT_ID=Iv1.your_client_id
GITHUB_PRODUCTION_APP_ID=123456
TRAEFIK_HOST=spark-webhooks.example.com

# The RavenDB licence is NOT an environment variable — RavenDB ignores it as a
# setting. Put the licence JSON in ./raven-license.json next to docker-compose.yml; a
# one-shot service activates it. Omitting it leaves the server on AGPL.
