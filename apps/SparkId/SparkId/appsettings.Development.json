{
  "Spark": {
    "IdentityProvider": {
      // SparkId has no MCP endpoint of its own; it signs AI agents in for HR's (docs/guide-mcp.md, "A Spark identity
      // provider as the external server"). The URL is HR's Spark:Mcp:CanonicalUrl (its https launch profile): the only
      // audience these tokens get. HR accepts them through AddExternalAgentAuthorizationServer, mapped to the HR user
      // who linked their SparkId account. Nothing here is a secret.
      "Mcp": {
        "Resources": [
          { "Url": "https://localhost:5005/mcp", "DisplayName": "Spark HR" }
        ]
      }
    }
  }
}
