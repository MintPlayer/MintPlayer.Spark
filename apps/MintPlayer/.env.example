# /var/www/mintplayer/.env on the VPS (server-managed: deploys never write it; chmod 600).
# Every value below is a placeholder. The public hostname is hard-coded in docker-compose.yml (Traefik Host rule) and
# appsettings.Production.json.

# ─── Sign-in providers (the legacy site's and GitHub; a provider without a client id is not offered) ─
# Callbacks: https://mintplayer.com/signin-facebook | -github | -google | -linkedin | -microsoft | -twitter
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=your_entra_client_secret
TWITTER_CLIENT_ID=your_x_oauth2_client_id
TWITTER_CLIENT_SECRET=your_x_oauth2_client_secret

# ─── Mail (optional: the defaults are CodeCoverage's relay and the mail subdomain, PRD G3) ─────────
#MAIL_HOST=coverage-smtp
#MAIL_PORT=587
#MAIL_FROM_ADDRESS=noreply@mail.mintplayer.com
#MAIL_FROM_NAME=MintPlayer
