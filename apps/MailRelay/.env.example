# /var/www/mail-relay/.env — the shared outgoing mail relay (apps/MailRelay/docker-compose.yml).
# Server-managed: the deploy (.github/workflows/mail-relay-deploy.yml) refreshes only the compose file and never
# writes this. Every key is optional; the defaults are production's.

# The domains the relay accepts as envelope senders, space-separated, one per app. Anything else is refused rather
# than relayed, so a bug cannot turn this into an open relay. Each domain also needs a flat DKIM key in
# ./mail-dkim/<domain>.private and SPF + DKIM + DMARC records (docs/guide-outgoing-mail.md).
#MAIL_SENDER_DOMAIN=coverage.mintplayer.com seotester.mintplayer.com mail.mintplayer.com mintplayer.com

# Announced in HELO. ⚠️ Must match the server's reverse DNS (188.245.190.60 → coverage.mintplayer.com), or a good
# share of receivers refuse the mail outright. One name per address, whichever app sends.
#MAIL_HELO_HOSTNAME=coverage.mintplayer.com

# DKIM selector, the same for every domain; the private key goes FLAT in ./mail-dkim/<domain>.private (the relay reads
# /etc/opendkim/keys/<domain>.private and skips DKIM otherwise — not opendkim-genkey's <domain>/<selector>.private),
# owned 101:104, mode 600, and the public half in DNS as mail._domainkey.<domain>. See README.md.
#MAIL_DKIM_SELECTOR=mail

# Optional: relay through a provider instead of delivering directly. Direct delivery needs outbound port 25, which
# Hetzner blocks by default and unblocks on request (open on this VPS). Set these to fall back to a provider's
# submission host — which is also the right answer if deliverability from this IP turns out to be poor.
#MAIL_RELAY_HOST=[smtp.example.com]:587
#MAIL_RELAY_USERNAME=
#MAIL_RELAY_PASSWORD=
