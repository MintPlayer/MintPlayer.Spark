<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<SparkEntityLibrary>true</SparkEntityLibrary>
	</PropertyGroup>

	<ItemGroup>
		<!-- [JsonIgnore] on Question.Translations: RavenDB serializes through Newtonsoft. Stated explicitly:
		     it used to arrive only transitively, through the framework (#388). -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<!-- Attributes (+ Model) only, never the Web-SDK Abstractions: SPARKLIB001 fails the build if ASP.NET Core creeps back in (#388). -->
		<ProjectReference Include="..\..\..\libs\attributes\MintPlayer.Spark.Attributes\MintPlayer.Spark.Attributes.csproj" />
		<!-- The three #460 marker interfaces the entities implement. -->
		<ProjectReference Include="..\..\..\libs\moderation\MintPlayer.Spark.Moderation.Abstractions\MintPlayer.Spark.Moderation.Abstractions.csproj" />
		<ProjectReference Include="..\..\..\libs\soft_delete\MintPlayer.Spark.SoftDelete.Abstractions\MintPlayer.Spark.SoftDelete.Abstractions.csproj" />
		<!-- IAuditable, from the plain-SDK History.Abstractions: the History package references the whole framework (#388). -->
		<ProjectReference Include="..\..\..\libs\history\MintPlayer.Spark.History.Abstractions\MintPlayer.Spark.History.Abstractions.csproj" />
		<!-- Question.Translations is a [Contribution] (contributions M6); the generator comes from the targets below. -->
		<ProjectReference Include="..\..\..\libs\contributions\MintPlayer.Spark.Contributions.Abstractions\MintPlayer.Spark.Contributions.Abstractions.csproj" />
		<!-- Runs AttributeDescriptionsGenerator here, where the /// summaries live (#348). -->
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.LibraryGenerators\MintPlayer.Spark.LibraryGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- The contributions generator: analyzer ProjectReferences do not flow, so the declaring project imports it. -->
	<Import Project="..\..\..\libs\contributions\MintPlayer.Spark.Contributions\Targets\spark-contributions.targets" />

</Project>
