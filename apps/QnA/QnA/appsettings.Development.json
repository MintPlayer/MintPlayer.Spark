{
  "Spark": {
    // App_Data/moderation.json is the lowest-precedence configuration source (#460 D14), so this file
    // overrides it — the same way an operator overrides a threshold with Spark__Moderation__… on a server.
    // A fresh local database has no reputation anywhere; without these nobody but a moderator could
    // ever earn the first privilege, and a vote would take 48 hours to count.
    "Moderation": {
      "Fraud": {
        "CreditDelayHours": 0,
        "EligibleVoterMinAgeDays": 0,
        "EligibleVoterMinReputation": 0,
        "DiversityMinVoters": 1
      },
      "NewAccounts": { "AccountAgeDays": 0 }
    },
    // #490 M6: sign in against SparkId, the demo identity provider (run apps/SparkId with --launch-profile
    // https). Its migration M_202610081200_RelyingParties registers the "qna" client with redirect
    // https://localhost:5009/signin-SparkId. The secret is a published DEVELOPMENT-ONLY value shared with
    // that migration, not a credential; override it with user-secrets if you like.
    "Auth": {
      "Providers": {
        "OpenIdConnect": {
          "SparkId": {
            "DisplayName": "Spark Identity",
            "Authority": "https://localhost:5011",
            "ClientId": "qna",
            "ClientSecret": "dev-only-qna-secret-not-for-production"
          }
        }
      }
    }
  },
  "QnA": {
    // Lets a moderator run Moderation's crediting and fraud-detector jobs on demand
    // (POST /qna-test/moderation/credit, /detect) instead of waiting for their schedule. Development
    // and the E2E host only; refused at startup in Production.
    "TestSeams": { "Enabled": true }
  }
}
