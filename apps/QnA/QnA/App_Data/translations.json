{
  "$schema": "../../../../schemas/translations.schema.json",
  "app": {
    "welcomeTitle": {
      "en": "Welcome to QnA",
      "fr": "Bienvenue sur QnA",
      "nl": "Welkom bij QnA"
    },
    "welcomeSubtitle": {
      "en": "Ask questions, answer them, and earn the privileges that keep the site tidy.",
      "fr": "Posez des questions, répondez-y et gagnez les privilèges qui gardent le site en ordre.",
      "nl": "Stel vragen, beantwoord ze en verdien de rechten die de site netjes houden."
    },
    "selectMenuItem": {
      "en": "Pick Questions in the sidebar to get started.",
      "fr": "Choisissez Questions dans le menu latéral pour commencer.",
      "nl": "Kies Vragen in de zijbalk om te beginnen."
    },
    "yourReputation": {
      "en": "Your reputation",
      "fr": "Votre réputation",
      "nl": "Uw reputatie"
    }
  },
  "model": {
    "Answer": {
      "label": {
        "en": "Answer",
        "fr": "Réponse",
        "nl": "Antwoord"
      },
      "attributes": {
        "AuthorId": {
          "label": {
            "en": "Author",
            "fr": "Auteur",
            "nl": "Auteur"
          },
          "description": {
            "en": "Who answered. Stamped by Moderation on create, never changed afterwards."
          }
        },
        "Body": {
          "label": {
            "en": "Body",
            "fr": "Contenu",
            "nl": "Inhoud"
          },
          "description": {
            "en": "The answer itself."
          }
        },
        "CreatedAt": {
          "label": {
            "en": "Created",
            "fr": "Créée",
            "nl": "Aangemaakt"
          },
          "description": {
            "en": "When the answer was created. Stamped by History."
          }
        },
        "CreatedBy": {
          "label": {
            "en": "Created by",
            "fr": "Créée par",
            "nl": "Aangemaakt door"
          },
          "description": {
            "en": "Who created the answer (a user id). Stamped by History."
          }
        },
        "DeletedAt": {
          "label": {
            "en": "Deleted at",
            "fr": "Supprimée le",
            "nl": "Verwijderd op"
          },
          "description": {
            "en": "When the answer was deleted."
          }
        },
        "DeletedBy": {
          "label": {
            "en": "Deleted by",
            "fr": "Supprimée par",
            "nl": "Verwijderd door"
          },
          "description": {
            "en": "Who deleted the answer (a user id)."
          }
        },
        "DeleteReason": {
          "label": {
            "en": "Delete reason",
            "fr": "Motif de suppression",
            "nl": "Reden van verwijdering"
          },
          "description": {
            "en": "Why the answer was deleted, when a reason was given."
          }
        },
        "IsDeleted": {
          "label": {
            "en": "Deleted",
            "fr": "Supprimée",
            "nl": "Verwijderd"
          },
          "description": {
            "en": "Whether the answer was deleted. Deleted answers are hidden everywhere until restored."
          }
        },
        "ModifiedAt": {
          "label": {
            "en": "Modified",
            "fr": "Modifiée",
            "nl": "Gewijzigd"
          },
          "description": {
            "en": "When the answer was changed last. Stamped by History."
          }
        },
        "ModifiedBy": {
          "label": {
            "en": "Modified by",
            "fr": "Modifiée par",
            "nl": "Gewijzigd door"
          },
          "description": {
            "en": "Who changed the answer last (a user id). Stamped by History."
          }
        },
        "PostedAt": {
          "label": {
            "en": "Posted",
            "fr": "Publiée",
            "nl": "Geplaatst"
          },
          "description": {
            "en": "When the answer was posted. Stamped by Moderation."
          }
        },
        "QuestionId": {
          "label": {
            "en": "Question",
            "fr": "Question",
            "nl": "Vraag"
          },
          "description": {
            "en": "The question this answers. A closed question refuses new answers."
          }
        },
        "Votes": {
          "label": {
            "en": "Votes",
            "fr": "Votes",
            "nl": "Stemmen"
          },
          "description": {
            "en": "The vote widget's slot on the page; the score lives in ModerationTallies/{id}."
          }
        }
      }
    },
    "Question": {
      "label": {
        "en": "Question",
        "fr": "Question",
        "nl": "Vraag"
      },
      "attributes": {
        "AuthorId": {
          "label": {
            "en": "Author",
            "fr": "Auteur",
            "nl": "Auteur"
