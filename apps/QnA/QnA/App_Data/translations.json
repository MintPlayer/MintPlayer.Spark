        },
        "Body": {
          "label": {
            "en": "Body",
            "fr": "Contenu",
            "nl": "Inhoud"
          },
          "description": {
            "en": "The question itself: what you tried and what you expected."
          }
        },
        "CreatedAt": {
          "label": {
            "en": "Created",
            "fr": "Créée",
            "nl": "Aangemaakt"
          },
          "description": {
            "en": "When the question was created. Stamped by History."
          }
        },
        "CreatedBy": {
          "label": {
            "en": "Created by",
            "fr": "Créée par",
            "nl": "Aangemaakt door"
          },
          "description": {
            "en": "Who created the question (a user id). Stamped by History."
          }
        },
        "DeletedAt": {
          "label": {
            "en": "Deleted at",
            "fr": "Supprimée le",
            "nl": "Verwijderd op"
          },
          "description": {
            "en": "When the question was deleted."
          }
        },
        "DeletedBy": {
          "label": {
            "en": "Deleted by",
            "fr": "Supprimée par",
            "nl": "Verwijderd door"
          },
          "description": {
            "en": "Who deleted the question (a user id)."
          }
        },
        "DeleteReason": {
          "label": {
            "en": "Delete reason",
            "fr": "Motif de suppression",
            "nl": "Reden van verwijdering"
          },
          "description": {
            "en": "Why the question was deleted, when a reason was given."
          }
        },
        "IsClosed": {
          "label": {
            "en": "Closed",
            "fr": "Fermée",
            "nl": "Gesloten"
          },
          "description": {
            "en": "A closed question takes no new answers. Changed with the Close and Reopen actions."
          }
        },
        "IsDeleted": {
          "label": {
            "en": "Deleted",
            "fr": "Supprimée",
            "nl": "Verwijderd"
          },
          "description": {
            "en": "Whether the question was deleted. Deleted questions are hidden everywhere until restored."
          }
        },
        "IsDraft": {
          "label": {
            "en": "Draft",
            "fr": "Brouillon",
            "nl": "Concept"
          },
          "description": {
            "en": "A draft is visible to its author only, until it is published by clearing this box."
          }
        },
        "ModifiedAt": {
          "label": {
            "en": "Modified",
            "fr": "Modifiée",
            "nl": "Gewijzigd"
          },
          "description": {
            "en": "When the question was changed last. Stamped by History."
          }
        },
        "ModifiedBy": {
          "label": {
            "en": "Modified by",
            "fr": "Modifiée par",
            "nl": "Gewijzigd door"
          },
          "description": {
            "en": "Who changed the question last (a user id). Stamped by History."
          }
        },
        "PostedAt": {
          "label": {
            "en": "Posted",
            "fr": "Publiée",
            "nl": "Geplaatst"
          },
          "description": {
            "en": "When the question was posted. Stamped by Moderation."
          }
        },
        "Tags": {
          "label": {
            "en": "Tags",
            "fr": "Étiquettes",
            "nl": "Tags"
          },
          "description": {
            "en": "Comma-separated tags, stored lower-case and without duplicates (at most five)."
          }
        },
        "Title": {
          "label": {
            "en": "Title",
            "fr": "Titre",
            "nl": "Titel"
          },
          "description": {
            "en": "One line that states the question."
          }
        },
        "Translations": {
          "label": {
            "en": "Translations",
            "fr": "Traductions",
            "nl": "Vertalingen"
          },
          "description": {
            "en": "The question in other languages, written by anyone signed in. Each language and script holds one version per translator; the latest one is shown, and every version stays in the history."
          }
        },
        "Votes": {
          "label": {
            "en": "Votes",
            "fr": "Votes",
            "nl": "Stemmen"
          },
          "description": {
            "en": "The vote widget's slot on the page. The score itself is never stored here: a vote writes ModerationTallies/{id}, so voting does not move this document's etag while its author edits it."
          }
        }
      }
    },
