{
  "Spark": {
    // Kestrel requesting a client certificate makes Windows show the certificate / smartcard
    // picker on every browser visit. Module-to-module certificate authentication is not something
    // you exercise by clicking around the demo, so it is off for local development.
    //
    // The E2E suite runs under the "E2E" environment and never reads this file, so
    // ModuleCertificateCredentialTests still exercise the real thing.
    "ClientCertificates": false,

    // Sign in against SparkId, the demo identity provider (run apps/SparkId with --launch-profile https).
    // Its migration M_202610081200_RelyingParties registers the "fleet" client with redirect
    // https://localhost:5003/signin-SparkId. The secret is a published DEVELOPMENT-ONLY value shared with
    // that migration, not a credential; override it with user-secrets if you like.
    "Auth": {
      "Providers": {
        "OpenIdConnect": {
          "SparkId": {
            "DisplayName": "Spark Identity",
            "Authority": "https://localhost:5011",
            "ClientId": "fleet",
            "ClientSecret": "dev-only-fleet-secret-not-for-production"
          }
        }
      }
    },

    // Machine tokens: Fleet trusts the tokens SparkId issues for the "fleet-api" audience.
    "JwtBearer": {
      "Authority": "https://localhost:5011"
    }
  }
}
