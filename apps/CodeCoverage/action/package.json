{
  "name": "coverage-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that uploads coverage reports to a self-hosted Coverage instance",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "@actions/glob": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
