{
  "name": "@mintplayer/coverage-upload-action",
  "version": "1.4.0",
  "private": true,
  "description": "GitHub Action that uploads coverage reports to a MintPlayer CodeCoverage server",
  "repository": {
    "type": "git",
    "url": "https://github.com/MintPlayer/MintPlayer.Spark",
    "directory": "apps/CodeCoverage/action"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Pieterjan De Clippel",
    "url": "https://github.com/MintPlayer",
    "email": "info@mintplayer.com"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify",
    "test": "vitest run",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
