{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitWriter": {
    "Root": "/data/jobs",
    "MinFreeBytes": 2147483648,
    "MaxJobBytes": 1073741824,
    "JobTimeoutSeconds": 180,
    "MaxConcurrentJobs": 1,
    "SlotWaitSeconds": 30,
    "MaxPatchBytes": 2097152
  }
}
