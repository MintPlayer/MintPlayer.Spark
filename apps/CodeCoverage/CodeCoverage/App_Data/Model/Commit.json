    "attributes": [
      {
        "id": "dff2e520-5b02-4e18-aed3-1d0b6d9ccd0d",
        "name": "AssemblyCompleteness",
        "label": {
          "en": "Assembly Completeness"
        },
        "description": {
          "en": "Complete / Partial copied from the assembly so lists and indexes can filter without loading it. Null for commits whose coverage predates assemblies (full uploads, treated as complete)."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 16,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "77203692-9b28-495d-913f-c8b34f038564",
        "name": "AuthoredAt",
        "label": {
          "en": "Authored At"
        },
        "description": {
          "en": "When the commit was authored, from the webhook payload; null for commits only seen through an upload."
        },
        "dataType": "datetime",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 8,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "eee6f50d-e887-4c84-9697-c479730de0b0",
        "name": "Branch",
        "label": {
          "en": "Branch"
        },
        "description": {
          "en": "The branch the commit was pushed to or the PR head branch, when known."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 3,
        "isArray": false,
        "showedOn": "Query, PersistentObject",
        "rules": []
      },
      {
        "id": "98971124-8b79-43ed-951c-29110c46577f",
        "name": "Coverage",
        "label": {
          "en": "Coverage"
        },
        "description": {
          "en": "The commit's headline: the assembled coverage (every finalized build of the commit unioned, plus files carried unchanged from the base), stamped by the assembler and denormalized for lists and badges."
        },
        "dataType": "AsDetail",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 4,
        "asDetailType": "CodeCoverage.Entities.CoverageSummary",
        "isArray": false,
        "showedOn": "Query, PersistentObject",
        "rules": [],
        "renderer": "coverage-bar"
      },
      {
        "id": "6a1f3c2e-8b4d-4e5f-9a70-1c2d3e4f5a6b",
        "name": "CoverageDeltaVsDefaultBranch",
        "label": {
          "en": "Δ base branch"
        },
        "description": {
          "en": "Percentage-point change versus the default branch's newest complete coverage at or before this commit's date — \"what would merging this do to the headline\". Equals CoverageDeltaVsParent on the default branch itself. Null when there is no such reference."
        },
        "dataType": "decimal",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": true,
        "order": 6,
        "isArray": false,
        "showedOn": "Query",
        "rules": [],
        "renderer": "coverage-delta"
      },
      {
        "id": "b8d4f2a1-7c39-4e60-9d18-2f5a6b0c3e77",
        "name": "CoverageDeltaVsParent",
        "label": {
          "en": "Δ parent"
        },
        "description": {
          "en": "Percentage-point change versus the git first parent (ParentSha), stamped by the assembler. Null when the parent has no coverage — rendered as \"—\", never as a fake zero."
        },
        "dataType": "decimal",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": true,
        "order": 5,
        "isArray": false,
        "showedOn": "Query",
        "rules": [],
        "renderer": "coverage-delta"
      },
      {
        "id": "4e7b2c90-1a6d-4f83-9b25-8c0d7a3e5f14",
        "name": "Date",
        "label": {
          "en": "Date"
        },
        "dataType": "datetime",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": true,
        "order": 7,
        "isArray": false,
        "showedOn": "Query, PersistentObject",
        "rules": [],
        "renderer": "date-time"
      },
      {
        "id": "3f8a2c61-9d54-4b0e-8f1a-6cd2e07b5a94",
        "name": "FirstSeenAtUtc",
        "label": {
          "en": "First Seen At Utc"
        },
        "description": {
          "en": "When this document was first created, by whichever path saw the commit first (webhook or upload). AuthoredAt only arrives via push/PR webhooks, so upload-only commits (the norm for OIDC auto-provisioned repos) would otherwise have nothing to sort by — lists order by AuthoredAt coalesced with this."
        },
        "dataType": "datetime",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 12,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "c1b18792-3a93-4b1b-a590-802beb91ba99",
        "name": "LatestBuildId",
        "label": {
          "en": "Latest Build Id"
        },
        "description": {
          "en": "The build whose coverage is shown for this commit (file tree reads its FileCoverage docs)."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 13,
        "query": "GetBuilds",
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "28215491-4f8b-44e6-8b58-52c03fee7b3c",
        "name": "Message",
        "label": {
          "en": "Message"
        },
        "description": {
          "en": "The commit message, as delivered by the push or pull-request webhook."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 11,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "c4fbe030-4e29-420f-903b-a72b0be54505",
        "name": "ParentLookupAttemptedAtUtc",
        "label": {
          "en": "Parent Lookup Attempted At Utc"
        },
        "description": {
          "en": "When the server last asked GitHub for the parent (whether or not it answered). The backfill job walks commits where this is null, so a repository without any API path is asked once, not forever."
        },
        "dataType": "datetime",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 15,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "70fecd30-b3d9-43d2-ad29-113dbc6fd4ab",
        "name": "ParentSha",
        "label": {
          "en": "Parent Sha"
        },
        "description": {
          "en": "Sha of the git first parent, used as the reference for the delta-vs-parent; see the source field for how much to trust it."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": true,
        "order": 10,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "11af8c16-15e9-42bd-b147-778cc8cf84db",
        "name": "ParentShaSource",
        "label": {
          "en": "Parent Sha Source"
        },
        "description": {
          "en": "Who set ParentSha: upload (the action's claim) or api (verified against GitHub's commits API). Only api is trusted for the Δ-vs-parent; older action builds sent the PR base sha under the same name."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 14,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "de160dcb-97ee-4254-aab4-4d70cc2aa5db",
        "name": "PullRequestNumber",
        "label": {
          "en": "Pull Request Number"
        },
        "description": {
          "en": "Number of the pull request this commit was seen on; null for plain pushes."
        },
        "dataType": "number",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 9,
        "isArray": false,
        "showedOn": "PersistentObject",
        "rules": []
      },
      {
        "id": "71ba0b8b-834e-4ebe-bb23-301ec8655791",
        "name": "Repository",
        "label": {
          "en": "Repository"
        },
        "description": {
          "en": "The repository this commit belongs to."
        },
        "dataType": "Reference",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 1,
        "query": "GetRepositories",
        "referenceType": "CodeCoverage.Entities.Repository",
