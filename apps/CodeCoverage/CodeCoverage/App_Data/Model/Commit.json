        "label": {
          "en": "Commit"
        },
        "description": {
          "en": "The full 40-character git commit sha."
        },
        "dataType": "string",
        "isRequired": false,
        "isVisible": true,
        "isReadOnly": false,
        "order": 2,
        "isArray": false,
        "showedOn": "Query, PersistentObject",
