        "name": "AccountGitHubId",
        "label": {
          "en": "Account Git Hub Id"
        },
        "description": {
          "en": "GitHub's numeric id for the owner this token uploads for, when Scope is \"Account\". Null on tokens issued before this field existed, which fall back to comparing AccountLogin so that no working token is invalidated by a deploy."
        },
        "dataType": "number",
