<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<UserSecretsId>coverage-app-7f4a24c3</UserSecretsId>
		<SpaRoot>ClientApp\</SpaRoot>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pinned to the version MintPlayer.Spark.Authorization pins, rather than the floating
		     10.0.* it carried out-of-tree: in-repo the two must not disagree. -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="MintPlayer.AspNetCore.Endpoints" Version="11.4.1-rc.0" />
		<PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="11.0.0-rc.3" />
		<PackageReference Include="MintPlayer.SourceGenerators" Version="13.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MintPlayer.SourceGenerators.Attributes" Version="13.0.0" GeneratePathProperty="true" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CodeCoverage.Library\CodeCoverage.Library.csproj" />
		<ProjectReference Include="..\CodeCoverage.GithubIntegration\CodeCoverage.GithubIntegration.csproj" />
		<!--
		  For MergeQueueWireRules only: the merge queue's git writer and this app hold coverage.yml and their requests to the
		  same rules (docs/coverage_merge_queue_PRD.md §0 D57). The reference points this way only; CodeCoverage.Git never
		  references anything Spark.
		-->
		<ProjectReference Include="..\CodeCoverage.Git\CodeCoverage.Git.csproj" />
		<!--
		  Referenced but NOT registered: their AddXxxIntegration() is a no-op until there is
		  something to register, and Program.cs calls only AddGithubIntegration(). Referencing them
		  now means a port adds one line to the composition root rather than also discovering that
		  three hand-maintained closures - this file, the Dockerfile restore layer and the solution
		  - each need editing too.
		-->
		<ProjectReference Include="..\CodeCoverage.GitlabIntegration\CodeCoverage.GitlabIntegration.csproj" />
		<ProjectReference Include="..\CodeCoverage.BitbucketIntegration\CodeCoverage.BitbucketIntegration.csproj" />
		<ProjectReference Include="..\..\..\libs\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
		<ProjectReference Include="..\..\..\libs\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
		<ProjectReference Include="..\..\..\libs\controllers\MintPlayer.Spark.Controllers\MintPlayer.Spark.Controllers.csproj" />
		<ProjectReference Include="..\..\..\libs\cron\MintPlayer.Spark.Cron\MintPlayer.Spark.Cron.csproj" />
		<ProjectReference Include="..\..\..\libs\dashboards\MintPlayer.Spark.Dashboards\MintPlayer.Spark.Dashboards.csproj" />
		<ProjectReference Include="..\..\..\libs\messaging\MintPlayer.Spark.Messaging\MintPlayer.Spark.Messaging.csproj" />
		<ProjectReference Include="..\..\..\libs\mail\MintPlayer.Spark.MailManager\MintPlayer.Spark.MailManager.csproj" />
		<!-- The MCP server for AI agents (plan M6) and its embedded authorization server (ForMcp().AgentsOnly(), PRD D24). -->
		<ProjectReference Include="..\..\..\libs\mcp\MintPlayer.Spark.Mcp\MintPlayer.Spark.Mcp.csproj" />
		<ProjectReference Include="..\..\..\libs\identity_provider\MintPlayer.Spark.IdentityProvider\MintPlayer.Spark.IdentityProvider.csproj" />
		<ProjectReference Include="..\..\..\libs\migrations\MintPlayer.Spark.Migrations\MintPlayer.Spark.Migrations.csproj" />
		<ProjectReference Include="..\..\..\libs\webhooks\MintPlayer.Spark.Webhooks.GitHub\MintPlayer.Spark.Webhooks.GitHub.csproj" />
		<ProjectReference Include="..\..\..\libs\webhooks\MintPlayer.Spark.Webhooks.GitHub.DevTunnel\MintPlayer.Spark.Webhooks.GitHub.DevTunnel.csproj" />
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.LibraryGenerators\MintPlayer.Spark.LibraryGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

<ItemGroup>
    <!--
      Two functions are internal rather than private purely so they can be asserted directly:
      ProjectAutomationRouter.IsSelfAuthored and ProjectAutomationRecipient.ResolveEventKeys.
      Both are pure, and both fail SILENTLY when wrong. A too-broad loop guard makes an event
      type permanently inert, and a resolver keyed on (event, action) alone maps a merge onto
      the "closed" rule. Neither is reachable through a recipient public surface without a
      webhook round trip, and such a test would pass with either defect present.
    -->
    <InternalsVisibleTo Include="CodeCoverage.Tests" />
  </ItemGroup>

</Project>
