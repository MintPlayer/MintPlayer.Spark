{
  "$schema": "../../../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "build": "22.31.0"
  },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/bs-theme-preboot.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/spark/**",
    "!/signin-*",
    "!/signout-*",
    "!/connect/**",
    "!/.well-known/**",
    "!/api",
    "!/api/**",
    "!/badge",
    "!/badge/**",
    "!/health",
    "!/health/**"
  ]
}
