# Nightly at 04:00 Brussels time (runbook R5): a renewal restarts RavenDB and the apps, so it happens at night.
# Persistent: a night missed while the server was off runs at the next boot.
[Unit]
Description=Nightly RavenDB certificate renewal check

[Timer]
OnCalendar=*-*-* 04:00:00 Europe/Brussels
Persistent=true

[Install]
WantedBy=timers.target
