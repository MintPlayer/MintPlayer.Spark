<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.Spark.Abstractions" Version="10.0.0-preview.68" />
		<!-- [JsonIgnore] on transient entity properties: RavenDB serializes through
		     Newtonsoft, so its attribute is what keeps a value out of the document. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
