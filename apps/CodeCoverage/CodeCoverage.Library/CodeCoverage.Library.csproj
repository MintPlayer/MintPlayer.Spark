<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- [JsonIgnore] on transient entity properties: RavenDB serializes through
		     Newtonsoft, so its attribute is what keeps a value out of the document. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\libs\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
		<!--
		  For SparkUser, which ApiToken.CreatedByUserId references. [Reference] takes a Type, so the
		  declaring assembly has to be referenced — there is no by-name overload.
		  ⚠️ This pulls the authorization package into an entity library, which is the opposite of
		  what #388 (entity libraries should not drag in dependencies) is trying to achieve. Revisit
		  it there: either SparkUser's identity contract moves somewhere lighter, or [Reference]
		  gains a by-name overload for exactly this case.
		-->
		<ProjectReference Include="..\..\..\libs\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
		<!-- Runs AttributeDescriptionsGenerator here, where the /// summaries live (#348). -->
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<!-- Keys the [ValueObject] types declared here. Analyzer ProjectReferences are not transitive. -->
		<ProjectReference Include="..\..\..\libs\source_generators\MintPlayer.Spark.LibraryGenerators\MintPlayer.Spark.LibraryGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
