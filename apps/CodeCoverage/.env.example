GITHUB_WEBHOOK_SECRET=whsec_your_webhook_secret
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.your_client_id
GITHUB_APP_CLIENT_SECRET=your_client_secret
# The public hostname is hardcoded in docker-compose.yml (Traefik Host rule +
# Coverage__BaseUrl), like the other MintPlayer deployments.

# The RavenDB licence is NOT an environment variable — RavenDB ignores it as a
# setting. Put the licence JSON in ./raven-license.json next to docker-compose.yml and a
# one-shot service activates it; see README "RavenDB licence". Omitting it leaves
# the server on AGPL/restricted, which is a supported state.

# Optional: signs the per-pull-request badge URL the bot puts in a PR comment,
# so a private repository's comment never carries the repo-wide badge token.
# Any high-entropy string; generate with `openssl rand -hex 32`. Leave unset and
# those comments fall back to text-only numbers, which is a degradation and not
# a failure. Rotating it invalidates only the badge images inside comments that
# are already posted — README badges use the badge token and are unaffected.
#COVERAGE_BADGE_SIGNING_KEY=

# Optional: the App's public slug (github.com/apps/<slug>) — "install the App"
# links point here; when unset they fall back to the generic apps page
#GITHUB_APP_SLUG=your-app-slug

# Optional: dev GitHub App id — this deployment processes its own App's
# webhooks and downstreams the dev App's webhooks to connected developers
# (websocket tunnel); leave unset if unused
#GITHUB_DEVELOPMENT_APP_ID=234567

# Also place the GitHub App's private key (App settings -> "Generate a private
# key") next to this file as ./github-app.pem — docker-compose bind-mounts it
# read-only into the container at /run/secrets/github-app.pem. It must be
# readable by the container's app user (UID 1654), e.g. chmod 644.
# A single-file bind mount binds the INODE: replace the key with
# `cat new.pem > github-app.pem` (never mv/scp over it) and verify the
# fingerprint per README "Deployment" step 2; /health/ready reports 503
# while the key is unusable.

# ─── Outgoing mail (optional) ─────────────────────────────────────────────────
#
# The app never talks to the internet: it hands a message to the coverage-smtp
# container on the internal network and returns. That container queues it and
# does the delivering, which is what keeps an internet round-trip out of the
# middle of a sign-in.
#
# Leave MAIL_FROM_ADDRESS unset and the app registers no mail transport at all —
# a supported state, and the one this deployment is in today. Spark then refuses
# to start only if ExternalLoginLinking is ConfirmByEmail, because a confirmation
# nobody sends is a link nobody makes.
#
# ⚠️ Delivery is the hard part, not the wiring. Before setting this, read the
# README's "Outgoing mail" section: reverse DNS, SPF and DKIM all have to line
# up, and mintplayer.com publishes DMARC sp=reject, so a subdomain address that
# is not set up properly is REJECTED rather than junked.
#MAIL_FROM_ADDRESS=no-reply@coverage.mintplayer.com
#MAIL_FROM_NAME=MintPlayer Coverage

# The domain coverage-smtp will accept as an envelope sender. Anything else is
# refused rather than relayed, so a bug cannot turn this into an open relay.
#MAIL_SENDER_DOMAIN=coverage.mintplayer.com

# Announced in HELO. ⚠️ Must match the server's reverse DNS, or a good share of
# receivers refuse the mail outright.
#MAIL_HELO_HOSTNAME=coverage.mintplayer.com

# DKIM selector; the private key goes in ./mail-dkim/<domain>/<selector>.private
# and the public half in DNS. See README.
#MAIL_DKIM_SELECTOR=mail

# Optional: relay through a provider instead of delivering directly. Direct
# delivery needs outbound port 25, which Hetzner blocks by default and unblocks
# on request. Set these to fall back to a provider's submission host — which is
# also the right answer if deliverability from this IP turns out to be poor.
#MAIL_RELAY_HOST=[smtp.example.com]:587
#MAIL_RELAY_USERNAME=
#MAIL_RELAY_PASSWORD=

# Disabled | WhenSignedIn | ConfirmByEmail. Governs what happens when a provider
# asserts an email that already belongs to an account. Left at Disabled until
# there is a second forge worth linking to.
#EXTERNAL_LOGIN_LINKING=Disabled
