<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The hardened git CLI runner shared by CodeCoverage's git sidecars: the read-only coverage-git mirror
	  (docs/coverage_commit_graph_PRD.md D5, D26) and the merge queue's git writer (docs/coverage_merge_queue_PRD.md D2, M2),
	  plus the merge queue's merge-tree resolver (§5.3).
	  ⚠️ Never reference MintPlayer.Spark, RavenDB.Client, Octokit or anything that brings them: both sidecars parse hostile
	  repositories, and GitMirror's SidecarIsolationTests walks this assembly's references too.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<RootNamespace>CodeCoverage.Git</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- ILogger only. Both consumers are ASP.NET Core hosts, so the shared framework is already there. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- [Register] for the merge queue's conflict resolvers and content validators (docs/coverage_merge_queue_PRD.md §10.3).
		     The attributes assembly holds attributes only; the generator runs at build time and ships nothing. -->
		<PackageReference Include="MintPlayer.SourceGenerators.Attributes" Version="13.0.0" />
		<PackageReference Include="MintPlayer.SourceGenerators" Version="13.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- The yaml and github-workflow content validators (docs/code-coverage/dependency-updates-PRD.md R15, gap C).
		     Parsing only: the event parser, never the deserializer, so no type is ever constructed from the text. The
		     same version the app's coverage.yml parser uses. -->
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CodeCoverage.GitMirror.Tests" />
		<InternalsVisibleTo Include="CodeCoverage.Git.Tests" />
		<InternalsVisibleTo Include="CodeCoverage.GitWriter.Tests" />
	</ItemGroup>

</Project>
