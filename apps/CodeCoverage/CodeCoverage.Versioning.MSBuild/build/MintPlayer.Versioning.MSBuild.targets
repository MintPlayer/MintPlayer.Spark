<Project>

	<!--
	  MintPlayer.Versioning.MSBuild (docs/coverage_package_versioning_PRD.md D9): a packable project's Version is the
	  highest <PackageId>/v<version> tag reachable from HEAD, which the versioning engine wrote when it released (or
	  seeded) the package. An unchanged package therefore packs at the version it already has, and
	  the push's skip-duplicate option skips it. A package with no tag yet (a repository's onboarding pull request, a
	  package not released yet) packs at 0.0.0-untagged in a pull-request, merge-queue or local build, and is not packed
	  in any other CI build.

	  On a release line (#638 D2), the versioning action exports MintPlayerVersioningMajors=id=major;… for the packages
	  anchored on the line's platform: each of those takes its highest tag of that major only, and one with no tag of it
	  warns MPV006 and is not packed where packages are published. Opt in to an error with
	  <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MPV006</MSBuildWarningsAsErrors>. Without the action, a
	  release/dotnet-N.x branch (GITHUB_BASE_REF, else GITHUB_REF_NAME) prefers each package's highest N.x tag.

	  Knobs:
	    MintPlayerVersioningSkip=true        leave this project's version alone
	    MintPlayerVersioningTagPrefix=X/v    read X's tags instead of $(PackageId)'s
	    MintPlayerVersioningTaskSource=path  compile the task from another file (a repository importing these targets
	                                         from source)
	-->
	<PropertyGroup>
		<MintPlayerVersioningTaskSource Condition="'$(MintPlayerVersioningTaskSource)' == ''">$(MSBuildThisFileDirectory)MintPlayer.Versioning.MSBuild.cs</MintPlayerVersioningTaskSource>
	</PropertyGroup>

	<UsingTask TaskName="MintPlayer.Versioning.MSBuild.ResolveTagVersion"
	           TaskFactory="RoslynCodeTaskFactory"
	           AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<Task>
			<Code Type="Class" Language="cs" Source="$(MintPlayerVersioningTaskSource)" />
		</Task>
	</UsingTask>

	<!-- MinVer's hook points: before anything reads Version (assembly attributes, the nuspec, restore's project spec for
	     project-to-project dependencies). _IntermediatePack is the first target of Pack, so the IsPackable below is set
	     before GenerateNuspec's condition reads it, even with no-build. Design-time builds skip it: the IDE spawns no git. -->
	<Target Name="MintPlayerVersioning"
	        BeforeTargets="BeforeCompile;CoreCompile;GetAssemblyVersion;_IntermediatePack;GenerateNuspec;_GenerateRestoreProjectSpec;_GetOutputItemsFromPack"
	        Condition="'$(DesignTimeBuild)' != 'true' And '$(MintPlayerVersioningSkip)' != 'true' And '$(IsPackable)' != 'false' And '$(_MintPlayerVersioningDone)' != 'true'">
		<PropertyGroup>
			<MintPlayerVersioningTagPrefix Condition="'$(MintPlayerVersioningTagPrefix)' == ''">$(PackageId)/v</MintPlayerVersioningTagPrefix>
		</PropertyGroup>
		<!-- An explicit version wins (#544 D1): a global Version or PackageVersion (`-p:` on the command line, or passed
		     down from a parent build) means the caller owns the version, so the task reads no tags and the project stays
		     packable. Only the task can tell: an assignment in a target overrides a global property. -->
		<ResolveTagVersion TagPrefix="$(MintPlayerVersioningTagPrefix)" WorkingDirectory="$(MSBuildProjectDirectory)"
		                   GitHubActions="$(GITHUB_ACTIONS)" GitHubEventName="$(GITHUB_EVENT_NAME)"
		                   Majors="$(MintPlayerVersioningMajors)" GitHubRefName="$(GITHUB_REF_NAME)" GitHubBaseRef="$(GITHUB_BASE_REF)">
			<Output TaskParameter="Version" PropertyName="MintPlayerVersion" />
			<Output TaskParameter="ExplicitVersion" PropertyName="_MintPlayerVersioningExplicit" />
			<Output TaskParameter="ExplicitPackageVersionOnly" PropertyName="_MintPlayerVersioningPackageOnly" />
		</ResolveTagVersion>
		<PropertyGroup>
			<!-- Only PackageVersion given: the assemblies follow it (#544 Q1). -->
			<Version Condition="'$(_MintPlayerVersioningPackageOnly)' == 'True'">$(PackageVersion)</Version>
			<MintPlayerVersion Condition="'$(_MintPlayerVersioningExplicit)' == 'True'"></MintPlayerVersion>
		</PropertyGroup>
		<!-- AssemblyVersion, FileVersion and InformationalVersion follow from Version in the SDK's GetAssemblyVersion. -->
		<PropertyGroup Condition="'$(_MintPlayerVersioningExplicit)' != 'True'">
			<Version>$(MintPlayerVersion)</Version>
			<PackageVersion>$(MintPlayerVersion)</PackageVersion>
			<!-- A package the engine never tagged is not packed where packages are published, so a placeholder can never
			     reach a feed. A pull-request or local build packs it at 0.0.0-untagged instead (the task decides). -->
			<IsPackable Condition="'$(MintPlayerVersion)' == '0.0.0-PLACEHOLDER'">false</IsPackable>
		</PropertyGroup>
		<PropertyGroup>
			<_MintPlayerVersioningDone>true</_MintPlayerVersioningDone>
		</PropertyGroup>
	</Target>

	<!-- In-repo dependencies (ProjectReference) pack as ">= the dependency's version", which on a release line is its highest
	     tag reachable there (backport PRD §8.4, S4). MintPlayerVersioningDependencyRanges=major-bounded (D10b, opt-in;
	     coverage.yml versioning.dependencyRanges) caps each below its next major: [10.1.0, 11.0.0). NuGet's pack takes the
	     range from the ProjectVersion metadata as it is. -->
	<Target Name="MintPlayerVersioningDependencyRanges" AfterTargets="_GetProjectReferenceVersions"
	        Condition="'$(MintPlayerVersioningDependencyRanges)' == 'major-bounded'">
		<ItemGroup>
			<_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
			                                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ProjectVersion)', '^\d+\.'))">
				<ProjectVersion>[%(ProjectVersion), $([MSBuild]::Add($([System.Text.RegularExpressions.Regex]::Match('%(ProjectVersion)', '^\d+').Value), 1)).0.0)</ProjectVersion>
			</_ProjectReferencesWithVersions>
		</ItemGroup>
	</Target>

	<!-- A project packed on its own (not through a solution, which sets SolutionPath) is expected to produce a package,
	     so the placeholder is an error there rather than the silent "not packed" a solution-wide pack wants (#544 D2).
	     _IntermediatePack runs only for the project being packed, never for its ProjectReferences, so a build or a
	     test run of a single project is unaffected. -->
	<Target Name="MintPlayerVersioningDirectPack" BeforeTargets="_IntermediatePack" DependsOnTargets="MintPlayerVersioning"
	        Condition="'$(MintPlayerVersioningSkip)' != 'true'">
		<Error Code="MPV005"
		       Condition="'$(MintPlayerVersion)' == '0.0.0-PLACEHOLDER' And ('$(SolutionPath)' == '' Or '$(SolutionPath)' == '*Undefined*')"
		       Text="MintPlayer.Versioning: $(PackageId) has no $(PackageId)/v&lt;version&gt; tag reachable from HEAD on this build, so packing it on its own would produce nothing. Pass -p:Version, tag it, or set IsPackable to false." />
	</Target>

	<!-- The backstop: a nuspec is never generated at the placeholder, whatever skipped the target above (a knob, or an
	     outer multi-targeting build that did not import these targets: AspNetCore.Tools published 14 placeholder packages
	     that way, master run 40132026912). The check sits in the body because a target's condition is read before its
	     DependsOnTargets run. -->
	<Target Name="MintPlayerVersioningGuard" BeforeTargets="GenerateNuspec" DependsOnTargets="MintPlayerVersioning">
		<Error Code="MPV004"
		       Condition="'$(IsPackable)' == 'true' And '$(PackageVersion)' == '0.0.0-PLACEHOLDER'"
		       Text="MintPlayer.Versioning: $(PackageId) would be packed at 0.0.0-PLACEHOLDER. Its version comes from a $(PackageId)/v&lt;version&gt; tag reachable from HEAD." />
	</Target>

</Project>
