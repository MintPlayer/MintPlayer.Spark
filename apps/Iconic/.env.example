# /var/www/iconic/.env on the VPS (server-managed: deploys never write it; chmod 600).
# Every value below is a placeholder. The public hostname is hard-coded in docker-compose.yml (Traefik Host rule) and
# appsettings.json / appsettings.Production.json.

# ─── Sign-in providers (PRD D7; a provider without a client id is not offered) ─────────────────────────────────
# Callbacks: https://iconic.mintplayer.com/signin-github | -google | -microsoft
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=your_entra_client_secret

# ─── Moderation (PRD D20): where "Report this" mails go. Unset, reporting answers 503. ─────────────────────────
REPORT_ADDRESS=moderation@example.com

# ─── Mail (optional: the defaults are the shared relay (apps/MailRelay) and noreply@mintplayer.com) ─────────────
#MAIL_HOST=mail-relay
#MAIL_PORT=587
#MAIL_FROM_ADDRESS=noreply@mintplayer.com
#MAIL_FROM_NAME=Iconic
