{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spark": {
    "Mail": {
      "ApplicationName": "Iconic",
      "From": { "Address": "noreply@mintplayer.com", "Name": "Iconic" }
    },
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "Iconic"
    }
  },
  "Iconic": {
    "PasskeyServerDomain": "iconic.mintplayer.com",
    "PublicBaseUrl": "https://iconic.mintplayer.com",
    // Where "Report this" on a shared drawing goes (D20). Set in the deployment's environment; unset, reporting answers 503.
    "ReportAddress": "",
    // docs/iconic_PRD.md D21.
    "Quotas": {
      "MaxProjects": 200,
      "MaxSceneBytes": 5242880,
      "MaxAttachmentBytes": 10485760,
      "MaxSnapshots": 20,
      "SavesPerMinute": 50
    }
  }
}
