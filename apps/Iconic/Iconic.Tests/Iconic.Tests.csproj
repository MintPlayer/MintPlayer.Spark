<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Iconic application's own tests: the editor's API (projects, scene patches, quotas, snapshots, sharing). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableSpaBuilder>false</EnableSpaBuilder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MintPlayer.Assertions" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MintPlayer.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Boots Iconic's real Program for the route-table snapshot. -->
    <Compile Include="..\..\..\tests\Shared\SparkAppRouteHost.cs" Link="_Shared\SparkAppRouteHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\testing\MintPlayer.Spark.Testing\MintPlayer.Spark.Testing.csproj" />
    <ProjectReference Include="..\Iconic\Iconic.csproj" />
  </ItemGroup>

</Project>
