<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MintPlayer.Assertions" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Skips a provider's tests when no server is configured (MIT). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MintPlayer.Assertions" />
  </ItemGroup>

  <!--
    #536 M4: the relational providers' own tests, against real servers. Until the split test harness (S17, M5) locates
    one, a server comes from SPARK_TEST_SQLSERVER / SPARK_TEST_POSTGRESQL (a connection string; each class creates
    and drops its own database). Without the variable a provider's tests are skipped.
  -->
  <!-- The store conformance suite every provider runs (#551 M7); its RavenDB and InMemory subclasses stay in Spark.Tests. -->
  <ItemGroup>
    <Compile Include="..\MintPlayer.Spark.Tests\Storage\SparkStoreConformanceTests.cs" Link="Storage\SparkStoreConformanceTests.cs" />
    <Compile Include="..\MintPlayer.Spark.Tests\Storage\SparkAtomicValuesConformanceTests.cs" Link="Storage\SparkAtomicValuesConformanceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.SqlServer\MintPlayer.Spark.SqlServer.csproj" />
    <ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.PostgreSql\MintPlayer.Spark.PostgreSql.csproj" />
    <ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.Relational.Design\MintPlayer.Spark.Relational.Design.csproj" />
  </ItemGroup>

</Project>
