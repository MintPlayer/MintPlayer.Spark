<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- #264 M6: validates the apps' App_Data files against the generated schemas (draft 2020-12). -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="MintPlayer.Assertions" Version="11.0.0-rc.5" />
    <!-- Plan M8: EndpointConventionsTests parses libs/ and apps/ to guard the endpoint conventions. Same version as the generators. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="WireMock.Net" Version="2.19.0" />
    <!-- #460 SP-D: decodes the server-rendered authenticator QR code the way a scanner would. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MintPlayer.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Reflection\Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #467 fixtures seeded through SparkTestDriver.SeedFromJsonAsync. -->
    <Content Include="Endpoints\PersistentObject\Selection\Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- DateTimeOffset sort/filter fixtures (docs/datetimeoffset_query_sort_filter_PRD.md). -->
    <Content Include="Services\Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- xUnit only reads this from the output directory, not the project root. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #460 spike S-M1: where embedded .mjml resources land for each naming layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Mail\SpikeM1Templates\folder\**\*.mjml" />
    <EmbeddedResource Include="Mail\SpikeM1Templates\suffix\*.mjml" />
    <EmbeddedResource Include="Mail\SpikeM1Templates\suffixnoculture\*.mjml" WithCulture="false" />
    <Content Include="Mail\SpikeM1Templates\content\*.mjml" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Mail\SpikeM1Templates\logical\**\*.mjml" LogicalName="SparkMailSpike/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
    <ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
    <ProjectReference Include="..\..\libs\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
    <ProjectReference Include="..\..\libs\webhooks\MintPlayer.Spark.Webhooks.GitHub\MintPlayer.Spark.Webhooks.GitHub.csproj" />
    <ProjectReference Include="..\..\libs\webhooks\MintPlayer.Spark.Webhooks.GitHub.DevTunnel\MintPlayer.Spark.Webhooks.GitHub.DevTunnel.csproj" />
    <ProjectReference Include="..\..\libs\socket_extensions\MintPlayer.Dotnet.SocketExtensions\MintPlayer.Dotnet.SocketExtensions.csproj" />
    <ProjectReference Include="..\..\libs\messaging\MintPlayer.Spark.Messaging\MintPlayer.Spark.Messaging.csproj" />
    <ProjectReference Include="..\..\libs\replication\MintPlayer.Spark.Replication\MintPlayer.Spark.Replication.csproj" />
    <ProjectReference Include="..\..\libs\identity_provider\MintPlayer.Spark.IdentityProvider\MintPlayer.Spark.IdentityProvider.csproj" />
    <ProjectReference Include="..\..\libs\subscription_worker\MintPlayer.Spark.SubscriptionWorker.Abstractions\MintPlayer.Spark.SubscriptionWorker.Abstractions.csproj" />
    <!-- The shipping worker package. Referenced so it is MEASURED at all: without this it appears in no coverage report. -->
    <ProjectReference Include="..\..\libs\subscription_worker\MintPlayer.Spark.SubscriptionWorker\MintPlayer.Spark.SubscriptionWorker.csproj" />
    <ProjectReference Include="..\..\libs\cron\MintPlayer.Spark.Cron\MintPlayer.Spark.Cron.csproj" />
    <ProjectReference Include="..\..\libs\soft_delete\MintPlayer.Spark.SoftDelete\MintPlayer.Spark.SoftDelete.csproj" />
    <ProjectReference Include="..\..\libs\history\MintPlayer.Spark.History\MintPlayer.Spark.History.csproj" />
    <ProjectReference Include="..\..\libs\moderation\MintPlayer.Spark.Moderation\MintPlayer.Spark.Moderation.csproj" />
    <!-- Contributions M5: the runtime, plus its generator through the targets imported below. -->
    <ProjectReference Include="..\..\libs\contributions\MintPlayer.Spark.Contributions\MintPlayer.Spark.Contributions.csproj" />
    <ProjectReference Include="..\..\libs\mail\MintPlayer.Spark.MailManager\MintPlayer.Spark.MailManager.csproj" />
    <ProjectReference Include="..\..\libs\controllers\MintPlayer.Spark.Controllers\MintPlayer.Spark.Controllers.csproj" />
    <ProjectReference Include="..\..\libs\migrations\MintPlayer.Spark.Migrations\MintPlayer.Spark.Migrations.csproj" />
    <ProjectReference Include="..\..\libs\all_features\MintPlayer.Spark.AllFeatures\MintPlayer.Spark.AllFeatures.csproj" />
    <ProjectReference Include="..\..\libs\client\MintPlayer.Spark.Client\MintPlayer.Spark.Client.csproj" />
    <ProjectReference Include="..\..\libs\testing\MintPlayer.Spark.Testing\MintPlayer.Spark.Testing.csproj" />
    <!-- #264 M6: the schema generator, called in-process by the schema guard tests. -->
    <ProjectReference Include="..\..\tools\SchemaGenerator\MintPlayer.Spark.SchemaGenerator.csproj" />
  </ItemGroup>

  <!--
    Imported explicitly because this repo consumes the package by ProjectReference, where NuGet's
    automatic build/ import does not apply. A downstream consumer using a PackageReference gets
    this for free.
  -->
  <Import Project="..\..\libs\testing\MintPlayer.Spark.Testing\Targets\spark-testing.targets" />
  <Import Project="..\..\libs\contributions\MintPlayer.Spark.Contributions\Targets\spark-contributions.targets" />

</Project>
