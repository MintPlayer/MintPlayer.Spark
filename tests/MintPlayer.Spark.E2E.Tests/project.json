{
  "name": "MintPlayer.Spark.E2E.Tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        { "env": "SPARK_E2E_HOST_COVERAGE" },
        "{workspaceRoot}/tools/test-shard.mjs",
        "{workspaceRoot}/tools/test-shard-weights.json",
        { "env": "SPARK_TEST_SHARD" }
      ],
      "options": {
        "cwd": "tests/MintPlayer.Spark.E2E.Tests",
        "command": "node ../../tools/test-shard.mjs . dotnet test --no-build --no-restore --settings ../../coverlet.runsettings --collect:\"XPlat Code Coverage\" --results-directory coverage --blame-hang --blame-hang-timeout 10m --blame-hang-dump-type none",
        "args": []
      },
      "configurations": {
        "local": {
          "command": "dotnet test --no-build --no-restore --blame-hang --blame-hang-timeout 10m --blame-hang-dump-type none"
        }
      }
    }
  }
}
