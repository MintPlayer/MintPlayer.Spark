<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- MintPlayer's GitHub Packages feed: new MintPlayer.Polyglot.* releases appear here minutes before nuget.org.
         It needs credentials even for public packages: set GH_PKG_USER and GH_PKG_TOKEN (a token with read:packages). -->
    <add key="github-mintplayer" value="https://nuget.pkg.github.com/MintPlayer/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-mintplayer>
      <add key="Username" value="%GH_PKG_USER%" />
      <add key="ClearTextPassword" value="%GH_PKG_TOKEN%" />
    </github-mintplayer>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-mintplayer">
      <package pattern="MintPlayer.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
