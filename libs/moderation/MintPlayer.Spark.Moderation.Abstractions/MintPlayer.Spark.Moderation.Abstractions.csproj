<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.Moderation.Abstractions</PackageId>
		<Version>11.0.0-preview.92</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>Contracts for MintPlayer.Spark moderation: IModeratable for domain entities that can be voted on, flagged and locked, the moderation right names, and the reputation event names. Reference this from Domain/Library projects; the host references MintPlayer.Spark.Moderation.</Description>
		<PackageTags>moderation;reputation;voting;flags;ravendb;spark</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\MintPlayer.Spark.Moderation\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- SparkReservedActions / SparkCoreActions: ModerationRights declares its verbs as reserved, and its
		     earnable defaults name core's verbs through their constants rather than a hand-kept copy. -->
		<ProjectReference Include="..\..\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
	</ItemGroup>

</Project>
