<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
	  Validates that MintPlayer.Spark.SourceGenerators is referenced correctly.
	  MintPlayer.Spark ships source generators as a companion package; the consuming
	  project must wire them up as analyzers, otherwise the generated DI registration
	  code will be missing at compile time.

	  Two valid reference forms:
	    A) PackageReference (NuGet consumers) — checked for PrivateAssets="all" and
	       IncludeAssets containing "analyzers".
	    B) ProjectReference with OutputItemType="Analyzer" and ReferenceOutputAssembly="false"
	       (local monorepo consumers, e.g. Demo apps). The MSBuild item semantics already
	       enforce analyzer-only flow, so no extra metadata checks needed.

	  Diagnostics:
	    SPARK001 — neither reference form is present.
	    SPARK002 — PackageReference is present but PrivateAssets is not "all".
	    SPARK003 — PackageReference is present but IncludeAssets does not include "analyzers".

	  Runs before CoreCompile so the errors surface early in the build, before the
	  compiler would otherwise fail with confusing "missing symbol" errors from the
	  generator output that never got generated.

	  The $(MintPlayerSparkSourceGeneratorsReferenceValidated) property dedupes with
	  MintPlayer.Spark.Authorization's equivalent target — first to run wins, second
	  skips silently. Flag is set before the Error tasks so it's set even when the
	  validation fails.
	-->
	<Target Name="SparkValidateSourceGeneratorsReference"
	        BeforeTargets="CoreCompile"
	        Condition="'$(MintPlayerSparkSourceGeneratorsReferenceValidated)' != 'true'">

		<PropertyGroup>
			<MintPlayerSparkSourceGeneratorsReferenceValidated>true</MintPlayerSparkSourceGeneratorsReferenceValidated>
		</PropertyGroup>

		<ItemGroup>
			<_SparkSourceGeneratorsPackageRef Include="@(PackageReference)"
			                                  Condition="'%(Identity)' == 'MintPlayer.Spark.SourceGenerators'" />
			<_SparkSourceGeneratorsProjectRef Include="@(ProjectReference)"
			                                  Condition="$([System.String]::new('%(Identity)').Replace('\', '/').EndsWith('MintPlayer.Spark.SourceGenerators/MintPlayer.Spark.SourceGenerators.csproj')) AND '%(OutputItemType)' == 'Analyzer'" />
		</ItemGroup>

		<PropertyGroup Condition="'@(_SparkSourceGeneratorsPackageRef)' != ''">
			<_SparkSourceGeneratorsPrivateAssets>%(_SparkSourceGeneratorsPackageRef.PrivateAssets)</_SparkSourceGeneratorsPrivateAssets>
			<_SparkSourceGeneratorsIncludeAssets>%(_SparkSourceGeneratorsPackageRef.IncludeAssets)</_SparkSourceGeneratorsIncludeAssets>
		</PropertyGroup>

		<Error Code="SPARK001"
		       Text="MintPlayer.Spark requires a reference to MintPlayer.Spark.SourceGenerators. Add one of the following:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;%0A  OR (for local monorepo projects)%0A  &lt;ProjectReference Include=&quot;...\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj&quot; OutputItemType=&quot;Analyzer&quot; ReferenceOutputAssembly=&quot;false&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' == '' AND '@(_SparkSourceGeneratorsProjectRef)' == ''" />

		<Error Code="SPARK002"
		       Text="MintPlayer.Spark.SourceGenerators PackageReference is missing PrivateAssets=&quot;all&quot; (found: '$(_SparkSourceGeneratorsPrivateAssets)'). Update the entry to:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' != '' AND '$(_SparkSourceGeneratorsPrivateAssets)' != 'all'" />

		<Error Code="SPARK003"
		       Text="MintPlayer.Spark.SourceGenerators PackageReference IncludeAssets must include 'analyzers' (found: '$(_SparkSourceGeneratorsIncludeAssets)'). Update the entry to:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' != '' AND '$(_SparkSourceGeneratorsPrivateAssets)' == 'all' AND !$(_SparkSourceGeneratorsIncludeAssets.Contains('analyzers'))" />

	</Target>

	<!--
	  Target: CopySparkAgentsGuide

	  Copies the package's AGENTS.md into the consuming project on every build, so a coding agent
	  working in that repo reads the same specification the package ships — without anyone having
	  to remember to sync it by hand.

	  Why a build target rather than documentation on a website: the guide is only useful at the
	  moment someone is writing code against the framework, and an agent reads the files in front
	  of it. A copy that drifts is worse than no copy, so it is refreshed on every build.

	  ⚠️ Lives in THIS file rather than its own. NuGet auto-imports exactly one
	  buildTransitive/$(PackageId).targets per package, so a second targets file would simply be
	  ignored.

	  ⚠️ MintPlayer.Spark.Testing ships its own AGENTS.md by the same mechanism, aimed at test
	  projects, and defaults to the SAME output path. A project referencing both packages imports
	  both targets, and the failure is not last-writer-wins: because each target declares
	  Inputs/Outputs, whichever runs first makes the file newer than the other's Inputs, so MSBuild
	  marks that target up to date and skips it FOREVER, silently. Hence the IsTestProject guard
	  below — a test project takes the Testing guide, everything else takes this one.

	  Two modes, selected by $(SparkAgentsGuideMode):

	    Copy    (default) — the full guide is copied in. Correct for a NuGet consumer: the source
	                        lives inside a package, so without a copy an agent cloning that repo
	                        sees nothing. The file's own front-matter tells them to commit it.
	    Pointer           — a short generated file pointing at the source under libs/. Correct
	                        in-repo, where the source of truth is already in the same tree:
	                        committing seven copies would duplicate it and put a diff in every app
	                        on every edit of the guide. This repo sets Pointer once, in the root
	                        Directory.Build.props, so every in-repo project is covered by one line
	                        and no external consumer ever sees it.

	  SkipUnchangedFiles plus the Inputs/Outputs pair keep the Copy path off the incremental-build
	  critical path. The Pointer path deliberately uses neither, relying on
	  WriteOnlyWhenDifferent instead — that is what keeps it out of the wedge described above, and
	  what keeps a tracked pointer from dirtying the worktree on every build.
	-->
	<PropertyGroup>
		<EnableSparkAgentsGuide Condition=" '$(EnableSparkAgentsGuide)' == '' ">true</EnableSparkAgentsGuide>
		<SparkAgentsGuideMode Condition=" '$(SparkAgentsGuideMode)' == '' ">Copy</SparkAgentsGuideMode>
		<SparkAgentsGuideSource Condition=" '$(SparkAgentsGuideSource)' == '' ">$(MSBuildThisFileDirectory)..\AGENTS.md</SparkAgentsGuideSource>
		<SparkAgentsGuideTarget Condition=" '$(SparkAgentsGuideTarget)' == '' ">$(MSBuildProjectDirectory)\AGENTS.md</SparkAgentsGuideTarget>

		<!-- A test project gets the Testing guide instead; see the collision note above. -->
		<_SparkAgentsGuideApplies Condition=" '$(EnableSparkAgentsGuide)' == 'true' And '$(IsTestProject)' != 'true' And Exists('$(SparkAgentsGuideSource)') ">true</_SparkAgentsGuideApplies>
	</PropertyGroup>

	<Target Name="CopySparkAgentsGuide"
	        BeforeTargets="BeforeBuild"
	        Inputs="$(SparkAgentsGuideSource)"
	        Outputs="$(SparkAgentsGuideTarget)"
	        Condition=" '$(_SparkAgentsGuideApplies)' == 'true' And '$(SparkAgentsGuideMode)' == 'Copy' ">

		<Copy SourceFiles="$(SparkAgentsGuideSource)"
		      DestinationFiles="$(SparkAgentsGuideTarget)"
		      SkipUnchangedFiles="true" />

		<Message Importance="low"
		         Text="[MintPlayer.Spark] Synced AGENTS.md into $(MSBuildProjectName)." />
	</Target>

	<Target Name="WriteSparkAgentsGuidePointer"
	        BeforeTargets="BeforeBuild"
	        Condition=" '$(_SparkAgentsGuideApplies)' == 'true' And '$(SparkAgentsGuideMode)' == 'Pointer' ">

		<PropertyGroup>
			<_SparkAgentsGuideRelative>$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), $([System.IO.Path]::GetFullPath('$(SparkAgentsGuideSource)'))).Replace('\', '/'))</_SparkAgentsGuideRelative>
		</PropertyGroup>

		<WriteLinesToFile File="$(SparkAgentsGuideTarget)"
		                  Overwrite="true"
		                  WriteOnlyWhenDifferent="true"
		                  Lines="---;remarks: &quot;Generated pointer. The guide itself lives in this same repository at the path below - edit it there, not here.&quot;;generated-by: &quot;MintPlayer.Spark build target (WriteSparkAgentsGuidePointer)&quot;;---;;# Spark agent guide;;See @$(_SparkAgentsGuideRelative)" />

		<Message Importance="low"
		         Text="[MintPlayer.Spark] Wrote AGENTS.md pointer in $(MSBuildProjectName) -> $(_SparkAgentsGuideRelative)." />
	</Target>

</Project>
