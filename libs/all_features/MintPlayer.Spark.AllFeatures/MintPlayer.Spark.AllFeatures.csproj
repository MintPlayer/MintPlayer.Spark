<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.AllFeatures</PackageId>
		<Version>11.0.0-preview.103</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>All-in-one package for MintPlayer.Spark. References all Spark libraries and source-generates AddSparkFull/UseSparkFull/MapSparkFull convenience methods.</Description>
		<PackageTags>low-code;framework;ravendb;crud;persistentobject;angular</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Reference all Spark packages (become transitive NuGet dependencies for consumers) -->
	<ItemGroup>
		<ProjectReference Include="..\..\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
		<ProjectReference Include="..\..\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
		<ProjectReference Include="..\..\messaging\MintPlayer.Spark.Messaging\MintPlayer.Spark.Messaging.csproj" />
		<ProjectReference Include="..\..\replication\MintPlayer.Spark.Replication\MintPlayer.Spark.Replication.csproj" />
		<ProjectReference Include="..\..\cron\MintPlayer.Spark.Cron\MintPlayer.Spark.Cron.csproj" />
		<ProjectReference Include="..\..\migrations\MintPlayer.Spark.Migrations\MintPlayer.Spark.Migrations.csproj" />
	</ItemGroup>

	<!-- Source generators (analyzer-only, no runtime assembly) -->
	<ItemGroup>
		<!--
		  SparkPackAnalyzer="true": each reference's built dll is packed into analyzers/dotnet/cs
		  (Directory.Build.targets, SparkPackReferencedAnalyzers), so both generators run for consumers.
		-->
		<ProjectReference Include="..\..\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SparkPackAnalyzer="true" />
		<ProjectReference Include="..\MintPlayer.Spark.AllFeatures.SourceGenerators\MintPlayer.Spark.AllFeatures.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SparkPackAnalyzer="true" />
		<!--
		  Not for this project's own compilation, but so it is built and packed: LibraryGenerators was
		  packed nowhere until now, so SPARK016 reached no external consumer at all: the diagnostic
		  that guards the generated row key was in-repo only. It also carries both [ValueObject] code
		  fixes, so without this the lightbulbs ship to nobody.
		-->
		<ProjectReference Include="..\..\source_generators\MintPlayer.Spark.LibraryGenerators\MintPlayer.Spark.LibraryGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SparkPackAnalyzer="true" />
	</ItemGroup>


	<!--
	  Pack the targets file for NuGet consumers.
	  buildTransitive ensures it flows to transitive consumers as well.
	-->
	<ItemGroup>
		<None Include="Targets\spark-allfeatures.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
	</ItemGroup>

</Project>
