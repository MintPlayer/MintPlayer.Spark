    },
    {
      "key": "application-team-developers",
      "resource": "InviteMember/OidcApplication",
      "groupId": "identity-provider:developers"
    },
    {
      "key": "application-live-developers",
      "resource": "SwitchToLive/OidcApplication",
      "groupId": "identity-provider:developers"
    },
    {
      "key": "application-development-developers",
