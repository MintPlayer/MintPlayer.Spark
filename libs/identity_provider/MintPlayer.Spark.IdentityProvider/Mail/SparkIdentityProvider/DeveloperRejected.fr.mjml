<mjml>
  <mj-head>
    <mj-title>Votre demande de développeur{{ if app_name }} sur {{ app_name }}{{ end }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Votre demande de développeur n'a pas été approuvée</mj-text>
        <mj-text>Un administrateur a décidé de ne pas approuver votre demande. Votre compte n'est pas concerné.</mj-text>
{{ if note }}
        <mj-text>La raison donnée : {{ note }}</mj-text>
{{ end }}
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
