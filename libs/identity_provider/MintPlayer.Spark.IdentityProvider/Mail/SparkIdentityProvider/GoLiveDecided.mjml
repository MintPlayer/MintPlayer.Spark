<mjml>
  <mj-head>
    <mj-title>{{ application }} {{ if approved }}is live{{ else }}stays in development{{ end }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if approved }}{{ application }} is live{{ else }}{{ application }} was not approved to go live{{ end }}</mj-text>
        <mj-text>{{ if approved }}Anyone can now sign in to {{ application }}.{{ else }}An administrator did not approve the switch to Live. Only its team can sign in to it.{{ end }}</mj-text>
{{ if note }}
        <mj-text>The reason given: {{ note }}</mj-text>
{{ end }}
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
