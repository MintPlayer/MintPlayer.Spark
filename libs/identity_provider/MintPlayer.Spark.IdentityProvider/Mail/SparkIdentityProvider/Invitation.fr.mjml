<mjml>
  <mj-head>
    <mj-title>{{ inviter }} vous invite à rejoindre {{ application }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Vous êtes invité à rejoindre {{ application }}</mj-text>
        <mj-text>{{ inviter }} vous a invité dans l'équipe de l'application {{ application }} en tant que {{ role }}.</mj-text>
        <mj-button href="{{ link }}">Accepter l'invitation</mj-button>
        <mj-text font-size="13px" color="#4b5563">Si le bouton ne fonctionne pas, ouvrez ce lien : <a href="{{ link }}">{{ link }}</a></mj-text>
        <mj-text font-size="13px" color="#4b5563">Vous devez vous connecter avec le compte auquel appartient cette adresse. L'invitation expire après {{ valid_for_days }} jours. Si vous ne l'attendiez pas, ignorez ce message.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
