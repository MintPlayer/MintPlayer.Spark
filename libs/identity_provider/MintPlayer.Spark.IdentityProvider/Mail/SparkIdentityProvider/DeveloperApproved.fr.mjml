<mjml>
  <mj-head>
    <mj-title>Vous êtes maintenant développeur{{ if app_name }} sur {{ app_name }}{{ end }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Votre demande de développeur a été approuvée</mj-text>
        <mj-text>Vous pouvez désormais enregistrer des applications qui connectent les utilisateurs{{ if app_name }} avec {{ app_name }}{{ end }}, inviter votre équipe et gérer leurs secrets.</mj-text>
{{ if portal_url }}
        <mj-button href="{{ portal_url }}">Ouvrir le portail des développeurs</mj-button>
        <mj-text font-size="13px" color="#4b5563">Si le bouton ne fonctionne pas, ouvrez ce lien : <a href="{{ portal_url }}">{{ portal_url }}</a></mj-text>
{{ end }}
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
