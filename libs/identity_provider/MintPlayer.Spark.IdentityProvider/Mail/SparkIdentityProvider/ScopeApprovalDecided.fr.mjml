<mjml>
  <mj-head>
    <mj-title>Scope {{ scope }} pour {{ application }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if approved }}Scope approuvé{{ else }}Scope refusé{{ end }}</mj-text>
        <mj-text>Le propriétaire de {{ resource }} {{ if approved }}a approuvé{{ else }}n'a pas approuvé{{ end }} le scope {{ scope }} pour votre application {{ application }}.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
