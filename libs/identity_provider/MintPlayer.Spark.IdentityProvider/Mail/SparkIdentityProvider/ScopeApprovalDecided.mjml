<mjml>
  <mj-head>
    <mj-title>Scope {{ scope }} for {{ application }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if approved }}Scope approved{{ else }}Scope not approved{{ end }}</mj-text>
        <mj-text>The owner of {{ resource }} {{ if approved }}approved{{ else }}did not approve{{ end }} the scope {{ scope }} for your application {{ application }}.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
