<mjml>
  <mj-head>
    <mj-title>You are now a developer{{ if app_name }} on {{ app_name }}{{ end }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Your developer request was approved</mj-text>
        <mj-text>You can now register applications that sign users in{{ if app_name }} with {{ app_name }}{{ end }}, invite your team and manage their secrets.</mj-text>
{{ if portal_url }}
        <mj-button href="{{ portal_url }}">Open the developer portal</mj-button>
        <mj-text font-size="13px" color="#4b5563">If the button does not work, open this link: <a href="{{ portal_url }}">{{ portal_url }}</a></mj-text>
{{ end }}
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
