<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Tests on MintPlayer.Spark.Testing: SparkTestDriver gives each test its own database on an embedded RavenDB
	  server, and SparkEndpointFactory boots a Spark host in process. The embedded server needs a RavenDB licence:
	  set RAVENDB_LICENSE to the licence JSON or to the path of its file, or put raven-license.log next to the
	  solution (it is in .gitignore).
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<!-- The host brings MintPlayer.AspNetCore.NodeServices, whose build would run npm in a ClientApp\ this project does not have. -->
		<EnableSpaBuilder>false</EnableSpaBuilder>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="SparkApp.Library.Entities" />
	</ItemGroup>

	<!-- Versions are in ../Directory.Packages.props (central package management). -->
	<ItemGroup>
		<PackageReference Include="MintPlayer.Spark.Testing" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"
		                  IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SparkApp\SparkApp.csproj" />
	</ItemGroup>

</Project>
