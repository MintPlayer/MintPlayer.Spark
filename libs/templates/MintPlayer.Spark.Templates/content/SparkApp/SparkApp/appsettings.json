{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
//#if (IsRaven)
  "AllowedHosts": "*",
//#if (UseGitHubWebhooks)
  "GitHub": {
    "_comment": "Your GitHub App. Keep WebhookSecret and the private key out of this file: use user-secrets or the environment.",
    "AppId": "",
    "ClientId": "",
    "PrivateKeyPath": "",
//#if (UseGitHubDevTunnel)
    "SmeeChannelUrl": "",
//#endif
    "WebhookSecret": ""
  },
//#endif
//#if (UseOpenSearch)
  "Search": {
    "OpenSearch": {
      "_comment": "The OpenSearch engine's address, e.g. http://localhost:9200. Empty: the RavenDB index answers.",
      "Uri": ""
    }
  },
//#endif
  "Spark": {
//#if (UseReplication)
    "Replication": {
      "ModuleName": "SparkApp",
      "ModuleUrl": "https://localhost:5007",
      "SparkModulesUrls": [ "http://localhost:8080" ],
      "SparkModulesDatabase": "SparkModules"
    },
//#endif
//#if (UseMail)
    "Mail": {
      "ApplicationName": "SparkApp",
      "From": { "Address": "noreply@sparkapp.example", "Name": "SparkApp" }
    },
//#endif
//#if (HasOidc)
    "Auth": {
      "Providers": {
        "OpenIdConnect": {
          "Oidc": {
            "DisplayName": "OpenID Connect",
            "Authority": "OIDC_AUTHORITY_PLACEHOLDER",
            "ClientId": "SparkApp"
          }
        }
      }
    },
//#endif
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "SparkApp"
    }
  }
//#else
  "AllowedHosts": "*"
//#endif
}
