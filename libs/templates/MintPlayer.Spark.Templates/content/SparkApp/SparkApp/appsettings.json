{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
//#if (IsRaven)
  "AllowedHosts": "*",
  "Spark": {
//#if (UseMail)
    "Mail": {
      "ApplicationName": "SparkApp",
      "From": { "Address": "noreply@sparkapp.example", "Name": "SparkApp" }
    },
//#endif
//#if (HasOidc)
    "Auth": {
      "Providers": {
        "OpenIdConnect": {
          "Oidc": {
            "DisplayName": "OpenID Connect",
            "Authority": "OIDC_AUTHORITY_PLACEHOLDER",
            "ClientId": "SparkApp"
          }
        }
      }
    },
//#endif
    "RavenDb": {
      "Urls": [ "http://localhost:8080" ],
      "Database": "SparkApp"
    }
  }
//#else
  "AllowedHosts": "*"
//#endif
}
