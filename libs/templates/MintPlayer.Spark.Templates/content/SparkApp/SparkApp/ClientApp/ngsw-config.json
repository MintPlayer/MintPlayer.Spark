{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [ "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/bs-theme-preboot.js" ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/spark/**",
    "!/signin-*",
    "!/signout-*"
  ]
}
