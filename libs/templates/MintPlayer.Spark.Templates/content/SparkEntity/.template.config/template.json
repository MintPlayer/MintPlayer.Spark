{
  "$schema": "http://json.schemastore.org/template",
  "author": "MintPlayer",
  "classifications": [ "Web", "Spark" ],
  "identity": "MintPlayer.Spark.Templates.SparkEntity",
  "name": "Spark entity",
  "description": "An entity class for a Spark model type. Run it in the entity library's project directory; it writes Entities/<name>.cs.",
  "shortName": "spark-entity",
  "sourceName": "SparkItem",
  "preferNameDirectory": false,
  "tags": { "language": "C#", "type": "item" },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "The project's root namespace. Defaults to the RootNamespace of the project in or above the output directory."
    },
    "rootNamespace": { "type": "bind", "binding": "msbuild:RootNamespace", "defaultValue": "UnrestoredProject" },
    "effectiveNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "namespace", "fallbackVariableName": "rootNamespace" },
      "replaces": "SparkNs"
    },
    "plural": {
      "type": "parameter",
      "datatype": "text",
      "description": "The name of the context property listing them. Defaults to the name with an 's'."
    },
    "defaultPlural": {
      "type": "generated",
      "generator": "join",
      "parameters": { "symbols": [ { "type": "ref", "value": "name" }, { "type": "const", "value": "s" } ] }
    },
    "effectivePlural": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "plural", "fallbackVariableName": "defaultPlural" },
      "replaces": "SparkPluralName"
    }
  },
  "primaryOutputs": [ { "path": "Entities/SparkItem.cs" } ]
}
