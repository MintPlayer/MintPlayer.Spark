{
  "$schema": "http://json.schemastore.org/template",
  "author": "MintPlayer",
  "classifications": [ "Web", "Spark" ],
  "identity": "MintPlayer.Spark.Templates.SparkLookup",
  "name": "Spark lookup",
  "description": "A fixed list of translated values for an entity property. Run it in the entity library's project directory; it writes LookupReferences/<name>.cs.",
  "shortName": "spark-lookup",
  "sourceName": "SparkItem",
  "preferNameDirectory": false,
  "tags": { "language": "C#", "type": "item" },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "The project's root namespace. Defaults to the RootNamespace of the project in or above the output directory."
    },
    "rootNamespace": { "type": "bind", "binding": "msbuild:RootNamespace", "defaultValue": "UnrestoredProject" },
    "effectiveNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "namespace", "fallbackVariableName": "rootNamespace" },
      "replaces": "SparkNs"
    }
  },
  "primaryOutputs": [ { "path": "LookupReferences/SparkItem.cs" } ]
}
