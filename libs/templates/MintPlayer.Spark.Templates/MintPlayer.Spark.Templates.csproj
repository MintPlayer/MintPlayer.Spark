<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  `dotnet new` templates for Spark (docs/templates_dnx_terminal_PRD.md, Part A). The package holds no assembly:
	  only content/, which the template engine reads.

	  Versions (plan S2): the generated app pins every Spark package in a central Directory.Packages.props. That file is
	  NOT in content/: SparkTemplatePackageVersions writes it at pack time from the version each package resolves to
	  here, through the repository's own versioning targets (MintPlayerVersioning, Directory.Build.targets). A
	  release therefore ships a template that pins the versions released with it. A solution-wide pack with an explicit
	  -p:Version=X flows into every project, so a CI feed packed that way gives templates that pin X (the matrix, M4).
	-->

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<PackageType>Template</PackageType>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeContentInPack>true</IncludeContentInPack>
		<ContentTargetFolders>content</ContentTargetFolders>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<EnableDefaultItems>false</EnableDefaultItems>
		<!-- NU5128: a template package has no lib/ folder by design. -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.Templates</PackageId>
		<Version>0.0.0-PLACEHOLDER</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>dotnet new templates for MintPlayer.Spark: spark-app, a Spark host with an entity library and an Angular client, with a choice per framework feature.</Description>
		<PackageTags>dotnet-new;templates;spark;angular;ravendb</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!-- Everything under content/ except build output and Angular/npm state a local test run may leave behind. -->
		<Content Include="content\**\*"
		         Exclude="content\**\bin\**;content\**\obj\**;content\**\node_modules\**;content\**\.angular\**;content\**\dist\**"
		         PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!--
	  The feature parts of the template come from features.json (plan S6): the GenerateSparkTemplate task completes
	  template.json, ide.host.json, dotnetcli.host.json and the host csproj into obj/ at pack time, and returns the Spark
	  projects whose versions the template pins. Nothing it writes is checked in. TaskHostFactory runs the task in its
	  own process, so the task assembly is never locked by a long-lived MSBuild node.
	-->
	<ItemGroup>
		<None Include="features.json" />
		<ProjectReference Include="..\MintPlayer.Spark.Templates.Build\MintPlayer.Spark.Templates.Build.csproj"
		                  ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<UsingTask TaskName="MintPlayer.Spark.Templates.Build.GenerateSparkTemplate" TaskFactory="TaskHostFactory"
	           AssemblyFile="$(MSBuildThisFileDirectory)..\MintPlayer.Spark.Templates.Build\bin\$(Configuration)\net11.0\MintPlayer.Spark.Templates.Build.dll" />

	<!-- Third-party packages the generated app references. Bumped by hand (or by the dependency bot) like any other. -->
	<ItemGroup>
		<SparkTemplateExternalPackage Include="MintPlayer.AspNetCore.SpaServices" Version="11.0.0" />
		<SparkTemplateExternalPackage Include="MintPlayer.SourceGenerators" Version="13.1.2" />
	</ItemGroup>

	<!-- Only when this package is packed: where the versioning target turned it off (no tag of its own, in a build that
	     publishes), the Spark packages it pins may be unpacked too, and SPARKTPL001 would fail a build that packs nothing.
	     A dependent target's condition is read when it is about to run, after MintPlayerVersioning set IsPackable. -->
	<Target Name="SparkTemplatePackageVersions" BeforeTargets="_GetPackageFiles;GenerateNuspec"
	        DependsOnTargets="MintPlayerVersioning;_SparkTemplatePackageVersions" />

	<Target Name="_SparkTemplatePackageVersions" Condition="'$(IsPackable)' != 'false'">
		<!-- Set here, not in the body: IntermediateOutputPath is still empty when the project body is evaluated. -->
		<PropertyGroup>
			<_SparkTemplateGenerated>$(IntermediateOutputPath)template-generated\</_SparkTemplateGenerated>
		</PropertyGroup>
		<GenerateSparkTemplate ManifestFile="$(MSBuildThisFileDirectory)features.json"
		                       LibsDirectory="$(MSBuildThisFileDirectory)..\..\"
		                       TemplateDirectory="$(MSBuildThisFileDirectory)content\SparkApp\"
		                       OutputDirectory="$(_SparkTemplateGenerated)SparkApp\">
			<Output TaskParameter="GeneratedFiles" ItemName="_SparkTemplateGeneratedFile" />
			<Output TaskParameter="Packages" ItemName="SparkTemplatePackage" />
		</GenerateSparkTemplate>
		<ItemGroup>
			<Content Remove="@(_SparkTemplateGeneratedFile->'content\SparkApp\%(RelativePath)')" />
			<Content Include="@(_SparkTemplateGeneratedFile)" PackagePath="content\SparkApp\%(_SparkTemplateGeneratedFile.RelativePath)" />
		</ItemGroup>
		<!-- MintPlayerVersioning first: _GetProjectVersion only reads PackageVersion, which the versioning target sets.
		     Debug skips the tags (Directory.Build.targets), so a Debug pack pins 0.0.0-PLACEHOLDER: use Release.
		     RemoveProperties: global properties flow into these calls, so `dotnet pack -p:Version=X` of the template
		     pinned every package at X (found in M1: the preview-only Webhooks.GitHub was pinned 11.0.0, which does not
		     exist, and restore failed with NU1102). -->
		<MSBuild Projects="@(SparkTemplatePackage)" Targets="MintPlayerVersioning;_GetProjectVersion"
		         Properties="Configuration=$(Configuration)" RemoveProperties="Version;PackageVersion;VersionPrefix;VersionSuffix"
		         BuildInParallel="$(BuildInParallel)">
			<Output TaskParameter="TargetOutputs" ItemName="_SparkTemplateResolved" />
		</MSBuild>
		<Error Condition="'@(_SparkTemplateResolved->Count())' != '@(SparkTemplatePackage->Count())'"
		       Text="SparkTemplatePackageVersions resolved @(_SparkTemplateResolved->Count()) of @(SparkTemplatePackage->Count()) Spark package versions." />
		<!-- A package at the placeholder is never published (it has no tag, or this is a Debug build), so a template
		     pinning it would generate an app that cannot restore. MintPlayer.Spark.Minification and .SitemapXml were left
		     out of the template for that reason: neither has ever been tagged (2026-11-17). -->
		<Warning Code="SPARKTPL001" Condition="'$(Configuration)' == 'Debug' And '%(_SparkTemplateResolved.ProjectVersion)' == '0.0.0-PLACEHOLDER'"
		         Text="The template pins %(_SparkTemplateResolved.Filename) at 0.0.0-PLACEHOLDER: a Debug pack reads no tags. Pack in Release, or pass -p:Version." />
		<Error Code="SPARKTPL001" Condition="'$(Configuration)' != 'Debug' And '%(_SparkTemplateResolved.ProjectVersion)' == '0.0.0-PLACEHOLDER'"
		       Text="The template pins %(_SparkTemplateResolved.Filename) at 0.0.0-PLACEHOLDER: it has no %(_SparkTemplateResolved.Filename)/v&lt;version&gt; tag, so it is never published. Release it first, or take it out of the template." />

		<!-- Each line is metadata, not an item spec: MSBuild trims item specs, which would lose the indentation. -->
		<ItemGroup>
			<_SparkTemplatePropsLine Include="1" Text="&lt;Project&gt;" />
			<_SparkTemplatePropsLine Include="2" Text="	&lt;!-- Package versions for the whole solution (central package management). --&gt;" />
			<_SparkTemplatePropsLine Include="3" Text="	&lt;PropertyGroup&gt;" />
			<_SparkTemplatePropsLine Include="4" Text="		&lt;ManagePackageVersionsCentrally&gt;true&lt;/ManagePackageVersionsCentrally&gt;" />
			<_SparkTemplatePropsLine Include="5" Text="	&lt;/PropertyGroup&gt;" />
			<_SparkTemplatePropsLine Include="6" Text="	&lt;ItemGroup&gt;" />
			<_SparkTemplatePropsLine Include="@(_SparkTemplateResolved->'%(Filename)')" Text="		&lt;PackageVersion Include=&quot;%(_SparkTemplateResolved.Filename)&quot; Version=&quot;%(_SparkTemplateResolved.ProjectVersion)&quot; /&gt;" />
			<_SparkTemplatePropsLine Include="@(SparkTemplateExternalPackage)" Text="		&lt;PackageVersion Include=&quot;%(SparkTemplateExternalPackage.Identity)&quot; Version=&quot;%(SparkTemplateExternalPackage.Version)&quot; /&gt;" />
			<_SparkTemplatePropsLine Include="7" Text="	&lt;/ItemGroup&gt;" />
			<_SparkTemplatePropsLine Include="8" Text="&lt;/Project&gt;" />
		</ItemGroup>
		<WriteLinesToFile File="$(_SparkTemplateGenerated)Directory.Packages.props" Lines="@(_SparkTemplatePropsLine->'%(Text)')"
		                  Overwrite="true" WriteOnlyWhenDifferent="true" />

		<!-- The Angular client's ng-spark range: libs/node_packages/ng-spark/package.json keeps the last released version
		     (CLAUDE.md, "Versions come from tags"), so the range is ^<that>. -->
		<PropertyGroup>
			<_NgSparkPackageJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\node_packages\ng-spark\package.json'))</_NgSparkPackageJson>
			<NgSparkTemplateVersion>$([System.Text.RegularExpressions.Regex]::Match($(_NgSparkPackageJson), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</NgSparkTemplateVersion>
			<_ClientPackageJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)content\SparkApp\SparkApp\ClientApp\package.json'))</_ClientPackageJson>
		</PropertyGroup>
		<Error Condition="'$(NgSparkTemplateVersion)' == ''" Text="Could not read the version of libs/node_packages/ng-spark/package.json." />
		<WriteLinesToFile File="$(_SparkTemplateGenerated)package.json" Lines="$(_ClientPackageJson.Replace('NG_SPARK_VERSION', '$(NgSparkTemplateVersion)'))"
		                  Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Content Include="$(_SparkTemplateGenerated)Directory.Packages.props" PackagePath="content\SparkApp\Directory.Packages.props" />
			<Content Remove="content\SparkApp\SparkApp\ClientApp\package.json" />
			<Content Include="$(_SparkTemplateGenerated)package.json" PackagePath="content\SparkApp\SparkApp\ClientApp\package.json" />
		</ItemGroup>
	</Target>

</Project>
