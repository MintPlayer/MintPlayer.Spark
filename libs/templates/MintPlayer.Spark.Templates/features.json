      "id": "Contributions",
      "flag": "contributions",
      "project": "contributions/MintPlayer.Spark.Contributions/MintPlayer.Spark.Contributions.csproj",
      "displayName": "Contributions",
      "description": "Users propose changes to fields marked [Contribution]; owners accept or revert them.",
      "store": "RavenDB",
      "registration": "AddContributions",
      "client": [ "withContributions" ]
    },
    {
      "id": "Dashboards",
      "flag": "dashboards",
