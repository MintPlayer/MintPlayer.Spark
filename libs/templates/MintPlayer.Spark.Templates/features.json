      "store": "RavenDB",
      "requires": [ "Authorization", "Migrations" ],
      "registration": "AddIdentityProvider"
    },
    {
      "id": "Moderation",
      "flag": "moderation",
      "project": "moderation/MintPlayer.Spark.Moderation/MintPlayer.Spark.Moderation.csproj",
      "displayName": "Moderation",
      "description": "Reputation, votes, flags and review queues; the sample Person becomes moderatable.",
      "store": "RavenDB",
      "requires": [ "Authorization", "Cron", "Messaging" ],
      "registration": "AddModeration",
      "client": [ "withModeration" ]
    },
    {
      "id": "Replication",
      "flag": "replication",
      "project": "replication/MintPlayer.Spark.Replication/MintPlayer.Spark.Replication.csproj",
      "displayName": "Replication",
      "description": "Receive read-only copies of other Spark modules' collections through RavenDB ETL.",
      "store": "RavenDB",
      "alsoRequires": [ "Messaging" ],
      "registration": "AddReplication",
      "appsettings": "Spark:Replication",
      "$comment": "alsoRequires Messaging: its startup registration resolves IMessageBus, while the project references only Messaging.Abstractions."
    },
    {
      "id": "Settings",
      "flag": "settings",
      "project": "settings/MintPlayer.Spark.Settings/MintPlayer.Spark.Settings.csproj",
      "displayName": "Runtime settings",
      "description": "Settings administrators change at runtime, declared in AppSettings.cs.",
      "store": "RavenDB",
      "requires": [ "Authorization" ],
      "registration": "AddSettings"
    },
    {
      "id": "GitHubWebhooks",
      "flag": "github-webhooks",
      "project": "webhooks/MintPlayer.Spark.Webhooks.GitHub/MintPlayer.Spark.Webhooks.GitHub.csproj",
      "displayName": "GitHub webhooks",
      "description": "Receive a GitHub App's webhooks as messages, with a sample push handler.",
      "store": "RavenDB",
      "alsoRequires": [ "Messaging" ],
      "registration": "AddGithubWebhooks",
      "appsettings": "GitHub",
      "$comment": "alsoRequires Messaging: deliveries reach recipients through the message bus; the project references only Messaging.Abstractions."
    },
    {
      "id": "GitHubDevTunnel",
      "flag": "github-dev-tunnel",
      "project": "webhooks/MintPlayer.Spark.Webhooks.GitHub.DevTunnel/MintPlayer.Spark.Webhooks.GitHub.DevTunnel.csproj",
      "displayName": "GitHub webhooks dev tunnel",
      "description": "Receive the webhooks through a smee.io channel when GitHub:SmeeChannelUrl is set.",
      "store": "RavenDB",
      "requires": [ "GitHubWebhooks" ],
      "$comment": "Registered inside the AddGithubWebhooks options (AddSmeeDevTunnel), so no spark.X registration."
    },
    {
      "id": "Gs1",
      "flag": "gs1",
      "project": "gs1/MintPlayer.Spark.Gs1/MintPlayer.Spark.Gs1.csproj",
      "displayName": "GS1 barcodes",
      "description": "Parse GS1 barcodes and compute check digits and SSCCs."
