      "store": "RavenDB",
      "registration": "AddSoftDelete",
      "client": [ "withSoftDelete" ]
    },
    {
      "id": "Mcp",
      "flag": "mcp",
      "project": "mcp/MintPlayer.Spark.Mcp/MintPlayer.Spark.Mcp.csproj",
      "displayName": "MCP server",
      "description": "Let AI agents read and propose changes through the Model Context Protocol.",
      "store": "RavenDB",
      "registration": "AddMcp"
    },
    {
      "id": "Controllers",
      "flag": "controllers",
      "project": "controllers/MintPlayer.Spark.Controllers/MintPlayer.Spark.Controllers.csproj",
      "displayName": "MVC controllers",
      "description": "Mount ASP.NET Core controllers through Spark's pipeline.",
      "registration": "AddControllers"
    },
    {
      "id": "Logging",
      "flag": "logging",
      "project": "logging/MintPlayer.Spark.Logging/MintPlayer.Spark.Logging.csproj",
