  "features": [
    {
      "id": "Authorization",
      "symbol": "HasAuth",
      "selectedWhen": "AuthMode == \"authorization\" || AuthMode == \"oidc\"",
      "displayName": "Sign-in and authorization",
      "project": "authorization/MintPlayer.Spark.Authorization/MintPlayer.Spark.Authorization.csproj",
      "store": "RavenDB",
      "requires": [ "Migrations" ],
      "registration": "AddAuthentication",
      "client": [ "withAuth" ],
      "$comment": "Chosen through the hand-written AuthMode choice (none/authorization/oidc), so the generator emits no parameter for it; a feature that requires it still switches it on. It requires Migrations: the package ships migrations (M_202610041800, M_202610051200) that only the app's AddMigrations() runs."
    },
    {
      "id": "Migrations",
      "flag": "migrations",
      "project": "migrations/MintPlayer.Spark.Migrations/MintPlayer.Spark.Migrations.csproj",
      "displayName": "Migrations",
      "description": "Run-once database migrations at startup, with a sample seed migration.",
      "default": true,
      "store": "RavenDB",
      "registration": "AddMigrations"
    },
    {
      "id": "Messaging",
      "flag": "messaging",
      "project": "messaging/MintPlayer.Spark.Messaging/MintPlayer.Spark.Messaging.csproj",
      "displayName": "Messaging",
      "description": "A durable message bus.",
      "store": "RavenDB",
      "registration": "AddMessaging"
    },
    {
      "id": "Mail",
      "flag": "mail",
      "project": "mail/MintPlayer.Spark.MailManager/MintPlayer.Spark.MailManager.csproj",
      "displayName": "Outgoing mail",
      "description": "Templated mail; in Development it writes .eml files.",
      "store": "RavenDB",
      "requires": [ "Messaging" ],
      "registration": "AddMailManager",
      "appsettings": "Spark:Mail"
    },
    {
      "id": "Cron",
      "flag": "cron",
      "project": "cron/MintPlayer.Spark.Cron/MintPlayer.Spark.Cron.csproj",
      "displayName": "Cron jobs",
      "description": "Scheduled background jobs, with a sample job.",
      "store": "RavenDB",
      "registration": "AddCronJobs"
    },
    {
      "id": "History",
      "flag": "history",
      "project": "history/MintPlayer.Spark.History/MintPlayer.Spark.History.csproj",
      "displayName": "History",
      "description": "Revisions, audit stamping and revert.",
