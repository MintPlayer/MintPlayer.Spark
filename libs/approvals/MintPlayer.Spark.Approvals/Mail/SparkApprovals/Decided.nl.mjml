<mjml>
  <mj-head>
    <mj-title>{{ title }}: {{ status }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if status == "Approved" }}Uw aanvraag werd goedgekeurd{{ else if status == "Rejected" }}Uw aanvraag werd geweigerd{{ else if status == "Revoked" }}Een goedkeuring werd herroepen{{ else if status == "Expired" }}Uw aanvraag verliep zonder beslissing{{ else if status == "Stale" }}Uw aanvraag kon niet worden toegepast{{ else }}Uw aanvraag werd afgesloten{{ end }}</mj-text>
        <mj-text>{{ title }}</mj-text>
        {{ if reason }}<mj-text><strong>Reden:</strong> {{ reason }}</mj-text>{{ end }}
        {{ if link }}<mj-button href="{{ link }}">Aanvraag openen</mj-button>
        <mj-text font-size="13px" color="#4b5563">Werkt de knop niet? Open deze link: <a href="{{ link }}">{{ link }}</a></mj-text>{{ end }}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
