<mjml>
  <mj-head>
    <mj-title>Reset your password{{ if app_name }} for {{ app_name }}{{ end }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Reset your password</mj-text>
        <mj-text>Somebody asked to reset the password of {{ if app_name }}your {{ app_name }} account{{ else }}your account{{ end }}. If that was you, choose a new password with the button below.</mj-text>
        <mj-button href="{{ link }}">Choose a new password</mj-button>
        <mj-text font-size="13px" color="#4b5563">If the button does not work, open this link: <a href="{{ link }}">{{ link }}</a></mj-text>
        <mj-text font-size="13px" color="#4b5563">The link stops working after {{ valid_for_hours }} hours. If it was not you, do nothing: your password stays as it is.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_Footer.mjml" />
  </mj-body>
</mjml>
