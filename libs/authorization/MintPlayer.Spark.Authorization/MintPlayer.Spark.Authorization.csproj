<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<!-- Names this library's App_Data layers (composition D16). Permanent: it is part of every right key and model id the library ships. -->
		<SparkLibraryAlias>authorization</SparkLibraryAlias>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.Authorization</PackageId>
		<Version>11.0.0-preview.97</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>Optional authorization package for MintPlayer.Spark low-code framework. Provides group-based access control for PersistentObjects and Queries.</Description>
		<PackageTags>low-code;framework;authorization;security;access-control</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- #460 M8: the account mails' default MJML templates (SparkAuth/*), read by MailManager. An app
	     overrides one by placing a file with the same name in its Templates/Mail folder.
	     WithCulture="false" is load-bearing: without it MSBuild moves every Name.{culture}.mjml into a
	     satellite assembly under the neutral file's name (measured, spike S-M1). -->
	<ItemGroup>
		<EmbeddedResource Include="Mail\**\*.mjml;Mail\**\*.txt" LogicalName="SparkMail/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MintPlayer.Spark.Tests" />
		<InternalsVisibleTo Include="MintPlayer.Spark.IdentityProvider" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.SourceGenerators" Version="12.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MintPlayer.SourceGenerators.Attributes" Version="12.1.1" GeneratePathProperty="true" />
		<PackageReference Include="RavenDB.Client" Version="7.2.6" />
	</ItemGroup>

	<!-- Global usings required by the MintPlayer.AspNetCore.Endpoints source generator output -->
	<ItemGroup>
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.AspNetCore.Http" />
		<Using Include="Microsoft.AspNetCore.Routing" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.1.26425.128" />
		<!-- #460 D7: the provider presets (AddSparkGoogle, …) wrap Microsoft's own handlers. -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" Version="11.0.0-rc.1.26425.128" />
		<!-- #460 D16 / SP-D: server-rendered SVG QR code for authenticator enrollment. MIT, no dependencies. -->
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="MintPlayer.AspNetCore.Endpoints" Version="11.3.0-rc.0" />
		<ProjectReference Include="..\..\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
		<ProjectReference Include="..\MintPlayer.Spark.Authorization.Abstractions\MintPlayer.Spark.Authorization.Abstractions.csproj" />
		<!-- Ships M_202610041800 (#388); the app's generated AddMigrations() registers it. -->
		<ProjectReference Include="..\..\migrations\MintPlayer.Spark.Migrations\MintPlayer.Spark.Migrations.csproj" />
		<ProjectReference Include="..\..\mail\MintPlayer.Spark.MailManager.Abstractions\MintPlayer.Spark.MailManager.Abstractions.csproj" />
		<ProjectReference Include="..\..\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!--
		These targets apply when the package is installed via NuGet.
		buildTransitive makes them flow to transitive consumers as well.
		-->
		<None Include="Targets\spark-authorization.props" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
		<None Include="Targets\spark-authorization.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
		<!-- Template file for generated setup TypeScript -->
		<None Include="Targets\spark-auth.setup.template.ts" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

</Project>
