<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
	  Target: SparkAuthCheckNpmDependency  (#460, T9)
	  Warns when the SPA's package.json does not declare @mintplayer/ng-spark (whose auth/* entry points the generated setup imports).

	  This replaces SparkAuthEnsureNpmPackage, which ran `npm i` during the .NET build: in the wrong
	  directory for a workspace whose node_modules live at the repository root, writing an unpinned
	  "^latest"-style range into package.json, and silently on every clean clone. Installing packages
	  is the developer's decision and belongs in package.json; the build only says when it is missing.

	  Reads the file as text: a JSON parser is not available to MSBuild without a task assembly, and a
	  dependency name in quotes is unambiguous enough for a warning.
	-->
	<Target Name="SparkAuthCheckNpmDependency"
	        BeforeTargets="Build"
	        Condition=" '$(EnableSparkAuthSpa)' == 'true' And Exists('$(SpaRoot)package.json') ">

		<ReadLinesFromFile File="$(SpaRoot)package.json">
			<Output TaskParameter="Lines" ItemName="_SparkAuthPackageJsonLines" />
		</ReadLinesFromFile>

		<PropertyGroup>
			<_SparkAuthPackageJson>@(_SparkAuthPackageJsonLines)</_SparkAuthPackageJson>
		</PropertyGroup>

		<Warning Code="SPARK030"
		         Condition=" !$(_SparkAuthPackageJson.Contains('&quot;$(SparkAuthNpmPackage)&quot;')) "
		         Text="[MintPlayer.Spark.Authorization] $(SpaRoot)package.json does not declare $(SparkAuthNpmPackage). The generated spark-auth.setup.ts imports it; add it to the SPA's dependencies (with the major version matching your Angular major), e.g. npm install $(SparkAuthNpmPackage)@^22 in the directory that owns node_modules. Set EnableSparkAuthSpa=false to silence this for a project without the Spark SPA." />
	</Target>

	<!--
	  Target: SparkAuthValidateSourceGeneratorsReference
	  Validates that MintPlayer.Spark.SourceGenerators is referenced correctly.
	  MintPlayer.Spark.Authorization ships source generators as a companion package; the
	  consuming project must wire them up as analyzers, otherwise the generated DI
	  registration code will be missing at compile time.

	  Two valid reference forms:
	    A) PackageReference (NuGet consumers) — checked for PrivateAssets="all" and
	       IncludeAssets containing "analyzers".
	    B) ProjectReference with OutputItemType="Analyzer" and ReferenceOutputAssembly="false"
	       (local monorepo consumers, e.g. Demo apps). The MSBuild item semantics already
	       enforce analyzer-only flow, so no extra metadata checks needed.

	  Diagnostics:
	    SPARK001 — neither reference form is present.
	    SPARK002 — PackageReference is present but PrivateAssets is not "all".
	    SPARK003 — PackageReference is present but IncludeAssets does not include "analyzers".

	  The $(MintPlayerSparkSourceGeneratorsReferenceValidated) property dedupes with
	  MintPlayer.Spark's equivalent target — first to run wins, second skips silently.
	  Flag is set before the Error tasks so it's set even when the validation fails.
	-->
	<Target Name="SparkAuthValidateSourceGeneratorsReference"
	        BeforeTargets="CoreCompile"
	        Condition="'$(MintPlayerSparkSourceGeneratorsReferenceValidated)' != 'true'">

		<PropertyGroup>
			<MintPlayerSparkSourceGeneratorsReferenceValidated>true</MintPlayerSparkSourceGeneratorsReferenceValidated>
		</PropertyGroup>

		<ItemGroup>
			<_SparkSourceGeneratorsPackageRef Include="@(PackageReference)"
			                                  Condition="'%(Identity)' == 'MintPlayer.Spark.SourceGenerators'" />
			<_SparkSourceGeneratorsProjectRef Include="@(ProjectReference)"
			                                  Condition="$([System.String]::new('%(Identity)').Replace('\', '/').EndsWith('MintPlayer.Spark.SourceGenerators/MintPlayer.Spark.SourceGenerators.csproj')) AND '%(OutputItemType)' == 'Analyzer'" />
		</ItemGroup>

		<PropertyGroup Condition="'@(_SparkSourceGeneratorsPackageRef)' != ''">
			<_SparkSourceGeneratorsPrivateAssets>%(_SparkSourceGeneratorsPackageRef.PrivateAssets)</_SparkSourceGeneratorsPrivateAssets>
			<_SparkSourceGeneratorsIncludeAssets>%(_SparkSourceGeneratorsPackageRef.IncludeAssets)</_SparkSourceGeneratorsIncludeAssets>
		</PropertyGroup>

		<Error Code="SPARK001"
		       Text="MintPlayer.Spark.Authorization requires a reference to MintPlayer.Spark.SourceGenerators. Add one of the following:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;%0A  OR (for local monorepo projects)%0A  &lt;ProjectReference Include=&quot;...\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj&quot; OutputItemType=&quot;Analyzer&quot; ReferenceOutputAssembly=&quot;false&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' == '' AND '@(_SparkSourceGeneratorsProjectRef)' == ''" />

		<Error Code="SPARK002"
		       Text="MintPlayer.Spark.SourceGenerators PackageReference is missing PrivateAssets=&quot;all&quot; (found: '$(_SparkSourceGeneratorsPrivateAssets)'). Update the entry to:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' != '' AND '$(_SparkSourceGeneratorsPrivateAssets)' != 'all'" />

		<Error Code="SPARK003"
		       Text="MintPlayer.Spark.SourceGenerators PackageReference IncludeAssets must include 'analyzers' (found: '$(_SparkSourceGeneratorsIncludeAssets)'). Update the entry to:%0A  &lt;PackageReference Include=&quot;MintPlayer.Spark.SourceGenerators&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; IncludeAssets=&quot;runtime; build; native; contentfiles; analyzers; buildtransitive&quot; /&gt;"
		       Condition="'@(_SparkSourceGeneratorsPackageRef)' != '' AND '$(_SparkSourceGeneratorsPrivateAssets)' == 'all' AND !$(_SparkSourceGeneratorsIncludeAssets.Contains('analyzers'))" />

	</Target>

	<!--
	  Target: SparkAuthGenerateSetupFile
	  Generates a TypeScript setup/scaffolding file if it doesn't already exist.
	  The file is generated ONCE and never overwritten, so developers can customize it.
	-->
	<Target Name="SparkAuthGenerateSetupFile"
	        BeforeTargets="Build"
	        Condition=" '$(EnableSparkAuthSpa)' == 'true'
	                    And '$(GenerateSparkAuthSetupFile)' == 'true'
	                    And Exists('$(SpaRoot)package.json')
	                    And !Exists('$(SparkAuthSetupFile)') ">

		<Message Importance="high"
		         Text="[MintPlayer.Spark.Authorization] Generating $(SparkAuthSetupFile)..." />

		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SparkAuthSetupFile)'))" />

		<Copy SourceFiles="$(MSBuildThisFileDirectory)spark-auth.setup.template.ts"
		      DestinationFiles="$(SparkAuthSetupFile)" />

		<Message Importance="high"
		         Text="[MintPlayer.Spark.Authorization] Generated $(SparkAuthSetupFile). You can customize this file - it will not be overwritten." />
	</Target>

</Project>
