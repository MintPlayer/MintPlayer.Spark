<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- #536 O16: see MintPlayer.Spark.Testing.RavenDB's targets. -->
	<ItemGroup Condition=" '$(SparkTestDatabaseAttributes)' != 'false' ">
		<AssemblyAttribute Include="MintPlayer.Spark.Testing.SparkTestDatabaseAttribute">
			<_Parameter1>typeof(MintPlayer.Spark.Testing.PostgreSqlSparkTestDatabaseProvider)</_Parameter1>
			<_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
