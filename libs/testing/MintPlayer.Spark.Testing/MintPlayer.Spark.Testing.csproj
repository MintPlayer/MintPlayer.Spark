<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!--
      This is a test-utilities library (RavenSparkTestDriver, SparkEndpointFactory, JsonFixtureImporter,
      VerifyDefaults), not a test project. It references xunit for IAsyncLifetime types but has no
      [Fact] tests. IsTestProject=false stops `dotnet test <sln>` from invoking VSTest on it, which
      would discover no tests and exit non-zero even though nothing is wrong.
    -->
    <IsTestProject>false</IsTestProject>

    <!-- NuGet Package Metadata -->
    <PackageId>MintPlayer.Spark.Testing</PackageId>
    <Version>0.0.0-PLACEHOLDER</Version>
    <Authors>MintPlayer</Authors>
    <Company>MintPlayer</Company>
    <Description>Provider-neutral test harness for MintPlayer.Spark apps: the test drivers (SparkTestDriver, SparkSharedDatabase), an in-memory Spark host factory (SparkEndpointFactory), the security and route-table helpers, and Verify snapshot defaults. Add the provider package for your database: MintPlayer.Spark.Testing.RavenDB, .SqlServer or .PostgreSql.</Description>
    <PackageTags>spark;testing;integration-tests;xunit;testhost</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />

    <!--
      AGENTS.md is the testing spec, and the .targets copies it into each consuming test project
      on build. Both must be IN the package: the targets file under build/ so NuGet auto-imports
      it, and the guide beside it because that is where the target looks for it.
    -->
    <None Include="AGENTS.md" Pack="true" PackagePath="\" />
    <None Include="Targets\spark-testing.targets" Pack="true" PackagePath="build\MintPlayer.Spark.Testing.targets" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestServer / GetTestClient (SparkEndpointFactory). The harness boots a host directly via
         IHost + TestServer, so it needs TestHost but not the heavier Mvc.Testing/WebApplicationFactory. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- SparkTestDatabasesTests drives the provider choice with its own candidates. -->
    <InternalsVisibleTo Include="MintPlayer.Spark.Tests" />
  </ItemGroup>

  <!--
    Neutral (#536 D35): no database client. The provider packages (.RavenDB, .SqlServer, .PostgreSql) plug a database
    into SparkEndpointFactory through ISparkTestDatabase. InMemory is no database, so its test database lives here
    (a project opts into it with [assembly: SparkTestDatabase(typeof(InMemorySparkTestDatabaseProvider))]).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
    <ProjectReference Include="..\..\spark\MintPlayer.Spark.InMemory\MintPlayer.Spark.InMemory.csproj" />
    <ProjectReference Include="..\..\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
  </ItemGroup>

</Project>
