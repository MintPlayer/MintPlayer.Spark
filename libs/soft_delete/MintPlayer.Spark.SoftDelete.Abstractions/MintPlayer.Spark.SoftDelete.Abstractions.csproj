<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.SoftDelete.Abstractions</PackageId>
		<Version>11.0.0-preview.95</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>Contracts for MintPlayer.Spark soft deletion: ISoftDeletable for domain entities, ISparkSoftDelete (delete with a reason, restore, purge). Reference this from Domain/Library projects; the host references MintPlayer.Spark.SoftDelete.</Description>
		<PackageTags>soft-delete;recycle-bin;gdpr;ravendb;spark</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\MintPlayer.Spark.SoftDelete\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
