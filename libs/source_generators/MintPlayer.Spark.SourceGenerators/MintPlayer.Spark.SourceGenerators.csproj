<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- NuGet Package Metadata -->
        <PackageId>MintPlayer.Spark.SourceGenerators</PackageId>
		<Version>11.0.0-preview.100</Version>
		<Authors>MintPlayer</Authors>
        <Company>MintPlayer</Company>
        <Description>Source generators for MintPlayer.Spark low-code framework. Auto-generates DI registration for Actions classes.</Description>
        <PackageTags>low-code;framework;source-generator;roslyn</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
        <RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MintPlayer.SourceGenerators.Tools" Version="12.1.1" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="MintPlayer.ValueComparerGenerator" Version="12.1.1" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="MintPlayer.ValueComparerGenerator.Attributes" Version="12.1.1" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>

    <!-- The layering engine, one source with the runtime's MintPlayer.Spark.Abstractions (composition D14). -->
    <ItemGroup>
        <Compile Include="..\..\spark\Shared\Layering\*.cs" Link="Layering\%(Filename)%(Extension)" />
    </ItemGroup>

    <!--
    The code fixes in CodeFixes/ derive from CodeFixProvider, which lives in
    Microsoft.CodeAnalysis.Workspaces. ExcludeAssets="runtime" satisfies the compiler while shipping
    nothing: the IDE host supplies Workspaces, and the command-line host never loads a fix provider.
    Same reference, same reasoning as MintPlayer.Spark.LibraryGenerators.csproj.

    ⚠️ Anything that reflects over this assembly with GetTypes() WITHOUT Workspaces present throws
    ReflectionTypeLoadException on the whole assembly. That once broke every generator test
    (R26, docs/issue_210_PRD.md); the test project now carries a real Workspaces reference for it.
    Code fixes live in the generator assembly that hosts their diagnostic (owner, 2026-10-05,
    docs/datetimeoffset_query_sort_filter_PRD.md D12) — never in a separate .CodeFixes assembly.
    -->
    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Microsoft.CodeAnalysis" Version="5.0.0" />
      <PackageReference Update="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
      <PackageReference Update="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>
</Project>
