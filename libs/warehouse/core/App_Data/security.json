{
  "$schema": "../../../../schemas/security.schema.json",
  "_comment": [
    "The warehouse core's rights (docs/warehouse_picking_PRD.md §4.5, §4.15; Q-W11), shipped as a library layer.",
    "Two slots the application must bind (an unbound slot refuses startup, which is the point: the host decides who",
    "works in its warehouse): warehouse:staff (the operator's employees: read stock, locations, items and tasks; move",
    "stock) and warehouse:supervisors (master data, owner links, reason codes, adjustments, lot status).",
    "Stock is read-only everywhere: balances, the ledger, lots, levels and tasks are only ever QueryRead; corrections",
    "are the WarehouseAdjustStock action with a reason code, and the ledger has no edit or delete path.",
    "Owner-organization members read their own items and stock (@authenticated, narrowed by Organizations' row",
    "policy to the rows of organizations they belong to: WD3, WI5).",
    "Opt out of all of these with \"libraries\": { \"warehouse\": false }."
  ],
  "rights": [
    { "key": "sites-staff", "resource": "QueryRead/WarehouseSite", "groupId": "warehouse:staff" },
    { "key": "zones-staff", "resource": "QueryRead/WarehouseZone", "groupId": "warehouse:staff" },
    { "key": "locations-staff", "resource": "QueryRead/WarehouseLocation", "groupId": "warehouse:staff" },
    { "key": "items-staff", "resource": "QueryRead/WarehouseItem", "groupId": "warehouse:staff" },
    { "key": "barcodes-staff", "resource": "QueryRead/BarcodeRegistration", "groupId": "warehouse:staff" },
    { "key": "reasons-staff", "resource": "QueryRead/ReasonCode", "groupId": "warehouse:staff" },
    { "key": "balances-staff", "resource": "QueryRead/StockBalance", "groupId": "warehouse:staff" },
    { "key": "movements-staff", "resource": "QueryRead/StockMovement", "groupId": "warehouse:staff" },
    { "key": "lots-staff", "resource": "QueryRead/StockLot", "groupId": "warehouse:staff" },
    { "key": "levels-staff", "resource": "QueryRead/StockLevel", "groupId": "warehouse:staff" },
    { "key": "tasks-staff", "resource": "QueryRead/WarehouseTask", "groupId": "warehouse:staff" },
    { "key": "command-staff", "resource": "Read/WarehouseStockCommand", "groupId": "warehouse:staff" },
    { "key": "move-staff", "resource": "WarehouseMoveStock/WarehouseStockCommand", "groupId": "warehouse:staff" },

    { "key": "sites", "resource": "QueryReadEditNew/WarehouseSite", "groupId": "warehouse:supervisors" },
    { "key": "zones", "resource": "QueryReadEditNewDelete/WarehouseZone", "groupId": "warehouse:supervisors" },
    { "key": "locations", "resource": "QueryReadEditNewDelete/WarehouseLocation", "groupId": "warehouse:supervisors" },
    { "key": "owner-links", "resource": "QueryReadEditNewDelete/WarehouseOwnerLink", "groupId": "warehouse:supervisors" },
    { "key": "items", "resource": "QueryReadEditNew/WarehouseItem", "groupId": "warehouse:supervisors" },
    { "key": "barcodes", "resource": "QueryReadEditNewDelete/BarcodeRegistration", "groupId": "warehouse:supervisors" },
    { "key": "reasons", "resource": "QueryReadEditNew/ReasonCode", "groupId": "warehouse:supervisors" },
    { "key": "command", "resource": "Read/WarehouseStockCommand", "groupId": "warehouse:supervisors" },
    { "key": "move", "resource": "WarehouseMoveStock/WarehouseStockCommand", "groupId": "warehouse:supervisors" },
    { "key": "adjust", "resource": "WarehouseAdjustStock/WarehouseStockCommand", "groupId": "warehouse:supervisors" },
    { "key": "recall", "resource": "WarehouseRecallLot/StockLot", "groupId": "warehouse:supervisors" },
    { "key": "quarantine", "resource": "WarehouseQuarantineLot/StockLot", "groupId": "warehouse:supervisors" },
    { "key": "release", "resource": "WarehouseReleaseLot/StockLot", "groupId": "warehouse:supervisors" },

    { "key": "all-items-staff", "resource": "AllOrganizations/WarehouseItem", "groupId": "warehouse:staff" },
    { "key": "all-barcodes-staff", "resource": "AllOrganizations/BarcodeRegistration", "groupId": "warehouse:staff" },
    { "key": "all-balances-staff", "resource": "AllOrganizations/StockBalance", "groupId": "warehouse:staff" },
    { "key": "all-movements-staff", "resource": "AllOrganizations/StockMovement", "groupId": "warehouse:staff" },
    { "key": "all-lots-staff", "resource": "AllOrganizations/StockLot", "groupId": "warehouse:staff" },
    { "key": "all-levels-staff", "resource": "AllOrganizations/StockLevel", "groupId": "warehouse:staff" },
    { "key": "all-tasks-staff", "resource": "AllOrganizations/WarehouseTask", "groupId": "warehouse:staff" },
    { "key": "all-items", "resource": "AllOrganizations/WarehouseItem", "groupId": "warehouse:supervisors" },
    { "key": "all-barcodes", "resource": "AllOrganizations/BarcodeRegistration", "groupId": "warehouse:supervisors" },
    { "key": "all-balances", "resource": "AllOrganizations/StockBalance", "groupId": "warehouse:supervisors" },
    { "key": "all-movements", "resource": "AllOrganizations/StockMovement", "groupId": "warehouse:supervisors" },
    { "key": "all-lots", "resource": "AllOrganizations/StockLot", "groupId": "warehouse:supervisors" },
    { "key": "all-levels", "resource": "AllOrganizations/StockLevel", "groupId": "warehouse:supervisors" },
    { "key": "all-tasks", "resource": "AllOrganizations/WarehouseTask", "groupId": "warehouse:supervisors" },

    { "key": "items-owners", "resource": "QueryRead/WarehouseItem", "groupId": "@authenticated" },
    { "key": "balances-owners", "resource": "QueryRead/StockBalance", "groupId": "@authenticated" },
    { "key": "levels-owners", "resource": "QueryRead/StockLevel", "groupId": "@authenticated" }
  ]
}
