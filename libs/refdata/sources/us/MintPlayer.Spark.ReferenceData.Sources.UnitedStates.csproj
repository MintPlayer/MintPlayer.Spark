<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.ReferenceData.Sources.UnitedStates</PackageId>
		<Version>11.0.0-preview.1</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>The United States reference-data adapter (docs/reference_data_PRD.md §4.4): U.S. Census Bureau state and county codes, county changes since 1970 as lineage, and the address-range feature files (street names and non-authoritative ZIP Codes, read with a small streaming dBASE reader), the U.S. country profile with per-county time zones, the id ledger and real sample fixtures.</Description>
		<PackageTags>reference-data;united-states;census;counties;spark</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!-- Real sample fixtures cut from the real files (RS8), and the id ledger (Q-R5). -->
		<EmbeddedResource Include="Fixtures\**\*" LogicalName="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
		<EmbeddedResource Include="Ledger\*.ndjson" LogicalName="Ledger/%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\core\MintPlayer.Spark.ReferenceData.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ReferenceData.Tests" />
	</ItemGroup>

</Project>
