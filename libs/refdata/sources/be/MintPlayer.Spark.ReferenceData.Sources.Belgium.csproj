<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<PackageId>MintPlayer.Spark.ReferenceData.Sources.Belgium</PackageId>
		<Version>11.0.0-preview.1</Version>
		<Authors>MintPlayer</Authors>
		<Company>MintPlayer</Company>
		<Description>The Belgian reference-data adapter (docs/reference_data_PRD.md §4.4): Statbel REFNIS (units since 1970), Statbel NIS6 (sections) and BeST postal streets (postal localities and streets), mapped with lineage derived without curation, the Belgian country profile, the id ledger and real sample fixtures.</Description>
		<PackageTags>reference-data;belgium;refnis;nis6;best-address;spark</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Spark</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Spark.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!-- Real sample fixtures cut from the real files (RS8), and the id ledger (Q-R5). Never bpost data. -->
		<EmbeddedResource Include="Fixtures\**\*" LogicalName="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
		<EmbeddedResource Include="Ledger\*.ndjson" LogicalName="Ledger/%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\core\MintPlayer.Spark.ReferenceData.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ReferenceData.Tests" />
	</ItemGroup>

</Project>
