<mjml>
  <mj-head>
    <mj-title>Er wacht een ticket voor {{ event_name }} op je</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if recipient_name }}{{ recipient_name }}, iemand{{ else }}Iemand{{ end }} geeft je een ticket voor {{ event_name }}</mj-text>
        <mj-text><strong>{{ ticket_type }}</strong>{{ if seat }} · {{ seat }}{{ end }}</mj-text>
        <mj-text>Aanvaard het voor {{ expires }}. Het ticket wordt dan op jouw naam uitgegeven met een nieuwe QR-code.</mj-text>
        <mj-button href="{{ accept_url }}">Ticket aanvaarden</mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
