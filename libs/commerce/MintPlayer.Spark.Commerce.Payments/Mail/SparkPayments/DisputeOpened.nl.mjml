<mjml>
  <mj-head>
    <mj-title>Een betaling wordt betwist: {{ reference }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Een koper betwist een betaling</mj-text>
        <mj-text>Bestelling {{ reference }}: {{ amount }} {{ currency }}.</mj-text>
        {{ if reason }}<mj-text>Opgegeven reden: {{ reason }}</mj-text>{{ end }}
        {{ if due_by }}<mj-text>Het bewijs moet ingediend zijn vóór {{ due_by }}.</mj-text>{{ end }}
        {{ if manual_only }}<mj-text>De provider aanvaardt bewijs alleen in zijn eigen dashboard: download het bewijsdossier op de pagina van het geschil en laad het daar op.</mj-text>{{ else }}<mj-text>Bekijk het bewijsdossier op de pagina van het geschil en dien het daar in.</mj-text>{{ end }}
        {{ if link }}<mj-button href="{{ link }}">Geschil openen</mj-button>
        <mj-text font-size="13px" color="#4b5563">Werkt de knop niet? Open dan deze link: <a href="{{ link }}">{{ link }}</a></mj-text>{{ end }}
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">U ontvangt deze mail omdat u de betalingen van deze verkoper beheert.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
