<mjml>
  <mj-head>
    <mj-title>{{ if credit }}Credit note{{ else }}Your invoice{{ end }} {{ number }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if credit }}Credit note{{ else }}Your invoice{{ end }} {{ number }}</mj-text>
        <mj-text>{{ issuer }}{{ if order }}, order {{ order }}{{ end }}: {{ total }} {{ currency }}.</mj-text>
        <mj-button href="{{ link }}">Download the PDF</mj-button>
        <mj-text font-size="13px" color="#4b5563">If the button does not work, open this link: <a href="{{ link }}">{{ link }}</a>. The link stays valid for 90 days; signed in, you find the document with your order at any time.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">You receive this mail because a document was issued for your purchase.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
