<mjml>
  <mj-head>
    <mj-title>Tickets are waiting for you</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, y{{ else }}Y{{ end }}our turn on the waiting list{{ if title }} for {{ title }}{{ end }}</mj-text>
        <mj-text>{{ quantity }} ticket(s) are reserved for you until {{ expires_at }} (UTC). After that they go to the next person on the list.</mj-text>
        <mj-text>Your personal code: <strong>{{ code }}</strong></mj-text>
        <mj-button href="{{ offer_url }}">Buy your tickets</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">You receive this mail because you joined the waiting list. The code works only for your account.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
