<mjml>
  <mj-head>
    <mj-title>Confirm your back-in-stock request</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">Confirm your request</mj-text>
        <mj-text>You asked to be mailed when {{ if title }}{{ title }}{{ else }}an item{{ end }} is back in stock. Confirm that this address is yours; without confirmation we forget the request in two days.</mj-text>
        <mj-button href="{{ confirm_url }}">Confirm</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">Did not ask for this? Ignore this mail.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
