<mjml>
  <mj-head>
    <mj-title>Back in stock</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if title }}{{ title }} is{{ else }}Your item is{{ end }} available again</mj-text>
        <mj-text>Nothing is reserved for you: the first to pay gets it.</mj-text>
        <mj-button href="{{ item_url }}">See the item</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">You receive this mail because you asked to be told when this item is back in stock. This was your only notice for it. <a href="{{ unsubscribe_url }}">Forget my request</a>.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
