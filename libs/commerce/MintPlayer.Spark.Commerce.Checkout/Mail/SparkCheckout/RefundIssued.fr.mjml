<mjml>
  <mj-head>
    <mj-title>Commande {{ number }} : remboursement de {{ amount }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, n{{ else }}N{{ end }}ous avons remboursé {{ amount }} pour la commande {{ number }}</mj-text>
        {{ if kept }}<mj-text>Retenu selon les conditions que vous avez acceptées : {{ kept }}.</mj-text>{{ end }}
        <mj-text>Le remboursement est versé sur le moyen de paiement que vous avez utilisé. Votre banque peut mettre quelques jours à l'afficher.</mj-text>
        {{ if link }}<mj-button href="{{ link }}">Voir votre commande</mj-button>{{ end }}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
