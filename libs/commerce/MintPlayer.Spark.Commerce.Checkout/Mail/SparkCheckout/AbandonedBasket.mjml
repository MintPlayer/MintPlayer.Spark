<mjml>
  <mj-head>
    <mj-title>Your basket is waiting</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, y{{ else }}Y{{ end }}ou left {{ lines }} item(s) in your basket</mj-text>
        <mj-text>Nothing is reserved for you: availability and prices may have changed.</mj-text>
        <mj-button href="{{ basket_url }}">Open your basket</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">You receive this mail because you agreed to news from us.{{ if unsubscribe_url }} <a href="{{ unsubscribe_url }}">Unsubscribe</a> with one click.{{ end }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
