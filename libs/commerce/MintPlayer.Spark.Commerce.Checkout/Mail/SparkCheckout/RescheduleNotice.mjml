<mjml>
  <mj-head>
    <mj-title>Order {{ number }}: the date changed</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, t{{ else }}T{{ end }}he event of order {{ number }} was rescheduled</mj-text>
        {{ if new_date }}<mj-text>New date: <strong>{{ new_date }}</strong>.</mj-text>{{ end }}
        {{ if note }}<mj-text>{{ note | html.escape }}</mj-text>{{ end }}
        <mj-text>Your tickets stay valid for the new date. If you cannot come, you can ask for a full refund until <strong>{{ closes_at }}</strong>.</mj-text>
        {{ if link }}<mj-button href="{{ link }}">Keep or refund</mj-button>{{ end }}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
