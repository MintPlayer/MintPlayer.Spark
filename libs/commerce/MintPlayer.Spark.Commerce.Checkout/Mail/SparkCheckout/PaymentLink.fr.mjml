<mjml>
  <mj-head>
    <mj-title>Payer la commande {{ number }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, v{{ else }}V{{ end }}otre commande {{ number }} attend son paiement</mj-text>
        <mj-text>Montant : {{ total }}. Vos places restent réservées jusqu'à la fin du délai de paiement.</mj-text>
        <mj-button href="{{ pay_url }}">Commande avec obligation de paiement</mj-button>
        <mj-text font-size="13px" color="#4b5563">Si le bouton ne fonctionne pas, ouvrez ce lien : <a href="{{ pay_url }}">{{ pay_url }}</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
