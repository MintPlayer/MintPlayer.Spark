<mjml>
  <mj-head>
    <mj-title>Bestelling {{ number }}: terugbetaling van {{ amount }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, we{{ else }}We{{ end }} hebben {{ amount }} terugbetaald voor bestelling {{ number }}</mj-text>
        {{ if kept }}<mj-text>Ingehouden volgens de voorwaarden die je aanvaardde: {{ kept }}.</mj-text>{{ end }}
        <mj-text>De terugbetaling gaat naar het betaalmiddel dat je gebruikte. Je bank kan er enkele dagen over doen om ze te tonen.</mj-text>
        {{ if link }}<mj-button href="{{ link }}">Je bestelling bekijken</mj-button>{{ end }}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
