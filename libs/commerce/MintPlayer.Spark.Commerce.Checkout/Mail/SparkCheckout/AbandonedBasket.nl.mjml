<mjml>
  <mj-head>
    <mj-title>Je winkelmandje wacht op je</mj-title>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#111827" />
      <mj-button background-color="#2563eb" color="#ffffff" border-radius="6px" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600">{{ if buyer_name }}{{ buyer_name }}, je{{ else }}Je{{ end }} liet {{ lines }} artikel(s) achter in je winkelmandje</mj-text>
        <mj-text>Er is niets voor je gereserveerd: beschikbaarheid en prijzen kunnen veranderd zijn.</mj-text>
        <mj-button href="{{ basket_url }}">Je winkelmandje openen</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 24px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">Je ontvangt deze mail omdat je ingestemd hebt met nieuws van ons.{{ if unsubscribe_url }} Met één klik <a href="{{ unsubscribe_url }}">uitschrijven</a>.{{ end }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
