<Project>
	<!--
	  Spark's app-level props/targets imported once, repo-wide, for applications only.
	  Here and not in Directory.Build.props: OutputType (from the csproj body or the Web SDK) and
	  IsTestProject (Microsoft.NET.Test.Sdk) are not known yet when Directory.Build.props is read, and
	  an opt-out written in the csproj body would be invisible there too. spark.props and
	  spark-authorization.props only set defaults-when-empty, so importing them after the body is
	  equivalent as long as no csproj body READS those properties at evaluation time.
	  Opt-out: <SparkApplication>false</SparkApplication> in the csproj.
	-->
	<PropertyGroup>
		<SparkApplication Condition="'$(SparkApplication)' == '' And '$(OutputType)' == 'Exe' And '$(IsTestProject)' != 'true'">true</SparkApplication>
	</PropertyGroup>
	<Import Project="$(MSBuildThisFileDirectory)libs\spark\MintPlayer.Spark\Targets\spark.props" Condition="'$(SparkApplication)' == 'true'" />
	<Import Project="$(MSBuildThisFileDirectory)libs\authorization\MintPlayer.Spark.Authorization\Targets\spark-authorization.props" Condition="'$(SparkApplication)' == 'true'" />
	<Import Project="$(MSBuildThisFileDirectory)libs\authorization\MintPlayer.Spark.Authorization\Targets\spark-authorization.targets" Condition="'$(SparkApplication)' == 'true'" />
	<Import Project="$(MSBuildThisFileDirectory)libs\spark\MintPlayer.Spark\Targets\spark.targets" Condition="'$(SparkApplication)' == 'true'" />

	<!--
	  The library-layer items for every in-repo project (composition D1): what the generator package's
	  build/ targets do for a project that references it from NuGet. The file guards itself: only a class
	  library that has App_Data layer files gets items, and the generator embeds them only when the
	  project references it.
	-->
	<Import Project="$(MSBuildThisFileDirectory)libs\source_generators\MintPlayer.Spark.SourceGenerators\build\MintPlayer.Spark.SourceGenerators.targets" Condition="'$(_SparkLibraryLayersImported)' != 'true'" />

	<!--
	  A LIBRARY's targets must only act when the app actually references that library, directly or
	  transitively, by project or by package. That is unknowable at evaluation time, but the resolved
	  ReferencePath knows it once references are resolved, and every spark-authorization target runs
	  later (BeforeTargets=Build/CoreCompile) and re-reads $(EnableSparkAuthSpa) when it is scheduled.
	  Without this gate DemoApp (no Authorization reference) got SPARK030 and a generated
	  ClientApp/src/spark-auth.setup.ts (measured in spike S4).
	-->
	<Target Name="_SparkGateAuthorizationTargets" AfterTargets="ResolveAssemblyReferences" Condition="'$(SparkApplication)' == 'true'">
		<PropertyGroup Condition="'@(ReferencePath->WithMetadataValue('Filename', 'MintPlayer.Spark.Authorization'))' == ''">
			<EnableSparkAuthSpa>false</EnableSparkAuthSpa>
		</PropertyGroup>
	</Target>

	<!-- Suppress launchSettings.json generation for Web SDK class libraries -->
	<PropertyGroup Condition="'$(OutputType)' == 'Library'">
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	</PropertyGroup>

	<!--
	  Test processes run without dynamic PGO (System.Runtime.TieredPGO=false in their
	  runtimeconfig.json, which the test host runs under).

	  Dynamic PGO instruments a method's tier-0 code to collect a profile, then recompiles it. That
	  pays off in a long-running server whose hot methods run millions of times. A test process is
	  the opposite case: thousands of distinct methods that each run a handful of times, so it pays
	  for the instrumentation and the rejit and rarely uses the result. Measured 2026-10-02 on
	  MintPlayer.Spark.Tests run alone (M8 item 13, PRD §5d): test-process CPU 172-181 s down to
	  134-139 s, no test changed. Production applications are unaffected: only test projects get it.

	  In the targets file, not the props, because IsTestProject is set by Microsoft.NET.Test.Sdk
	  after Directory.Build.props has been read.
	-->
	<PropertyGroup Condition="'$(IsTestProject)' == 'true'">
		<TieredPGO>false</TieredPGO>
	</PropertyGroup>

	<!--
	  Keep RavenDB's 623 MB embedded server out of bin/.

	  RavenDB.Embedded's own build/RavenDB.Embedded.targets copies contentFiles/any/any/**
	  (the whole RavenDBServer directory) into $(OutDir) on every build. Nx declares
	  {projectRoot}/bin/Debug as a cached output, so each referencing project became a ~600 MB
	  cache artifact. Pushing those to the self-hosted cache aborted with an nginx 499, and Nx
	  turns a cache failure into a task failure — which skipped the entire test sweep.

	  The server stops being a build output entirely. RavenServerLocator provisions it at run time
	  into a temp directory and points the test driver there. That is deliberately not done here
	  in MSBuild: the test task runs `dotnet test` in no-build mode, so on an Nx build cache hit
	  MSBuild never executes and anything copied by a target would simply be absent.

	  It also cannot just point at the restored NuGet package, tempting as that is — the server
	  writes a Temp directory next to its own binaries at startup (measured 2026-09-10), and that
	  store is shared by every solution on the machine.

	  Emptying the item lists is deliberate rather than overriding CopyRavenDBServer: the override
	  would depend on import order between Directory.Build.targets and NuGet's generated
	  .nuget.g.targets, whereas an empty item list is order-independent and degrades to a no-op if
	  the package ever stops defining them.

	  The server arrives by two independent routes and both have to be closed:

	    1. NuGet contentFiles. The nuspec marks the RavenDBServer tree buildAction="None"
	       copyToOutput="true", so the files land as None items carrying NuGetPackageId
	       metadata and are copied by the ordinary copy-to-output pass. Closing only route 2
	       leaves this one still copying, which is what made the first attempt look like a
	       no-op.
	    2. The package's own CopyRavenDBServer target, hooked into PrepareForRunDependsOn.
	-->
	<Target Name="SparkSkipRavenDBServerContent" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<None Remove="@(None->WithMetadataValue('NuGetPackageId', 'RavenDB.Embedded'))" />
		</ItemGroup>
	</Target>

	<Target Name="SparkSkipRavenDBServerCopy" BeforeTargets="CopyRavenDBServer">
		<ItemGroup>
			<RavenDBServer Remove="@(RavenDBServer)" />
		</ItemGroup>
	</Target>

	<!--
	  Suppressing the copy does not remove what earlier builds already put there. A working tree
	  that predates this change keeps 623 MB in bin/, and since Nx caches {projectRoot}/bin/Debug
	  wholesale it would go on being uploaded — the original defect, surviving its own fix on every
	  machine that had built before. Deleting it makes the transition self-healing rather than
	  something every developer has to be told to clean by hand.

	  Nothing reads the copy in bin/ any more: RavenServerLocator provisions its own directory.
	-->
	<Target Name="SparkRemoveStaleRavenDBServer" AfterTargets="CopyFilesToOutputDirectory"
			Condition="Exists('$(OutDir)RavenDBServer')">
		<RemoveDir Directories="$(OutDir)RavenDBServer" ContinueOnError="true" />
	</Target>

	<!--
	  SPARKLIB001: an entity library must not depend on ASP.NET Core (#388).

	  A project that sets <SparkEntityLibrary>true</SparkEntityLibrary> holds entities only, so a host
	  without the ASP.NET Core shared framework (a console tool, a worker, a test fixture) can load it.
	  One ProjectReference or PackageReference to a Web-SDK project (MintPlayer.Spark.Abstractions,
	  MintPlayer.Spark.Authorization, …) silently brings Microsoft.AspNetCore.App back, so the build fails.

	  A transitive framework reference reaches a plain-SDK project as a TransitiveFrameworkReference item,
	  populated by ResolvePackageAssets from project.assets.json, not as a FrameworkReference. Both are
	  checked. Proven red on HR.Library before the split, green on Attributes (PRD §3.5, S3).
	-->
	<Target Name="SparkEntityLibraryGuard" AfterTargets="ResolvePackageAssets"
			Condition="'$(SparkEntityLibrary)' == 'true'">
		<ItemGroup>
			<_SparkEntityLibraryAspNet Include="@(FrameworkReference);@(TransitiveFrameworkReference)"
				Condition="'%(Identity)' == 'Microsoft.AspNetCore.App'" />
		</ItemGroup>
		<Error Condition="'@(_SparkEntityLibraryAspNet)' != ''" Code="SPARKLIB001"
			Text="$(MSBuildProjectName) is an entity library (SparkEntityLibrary=true) but depends on the ASP.NET Core shared framework (Microsoft.AspNetCore.App), directly or through a ProjectReference/PackageReference. Reference MintPlayer.Spark.Attributes, MintPlayer.Spark.Model and the plain *.Abstractions packages, never MintPlayer.Spark.Abstractions or another Web-SDK project." />
	</Target>

	<!--
	  Test projects assert with MintPlayer.Assertions only (#452). xUnit's Assert is banned, and the
	  ban is an error, so a new call fails the build (RS0030) instead of slowly re-mixing two assertion
	  styles. Mind the argument order when converting: Assert.Equal(expected, actual) is
	  actual.Should().Be(expected).

	  ⚠️ Keyed on the project NAME, not IsTestProject. IsTestProject comes from Microsoft.NET.Test.Sdk's
	  package props, which restore does not import, so a PackageReference conditioned on it is never
	  restored and the ban silently does nothing (measured 2026-10-04: a probe Xunit.Assert.True built
	  clean). Every test project is named *.Tests; MintPlayer.Spark.Testing, the published package that
	  references xunit, is not.
	-->
	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
	</PropertyGroup>

	<!--
	  No test process consults the machine's proxy. With Windows' WPAD auto-detection on, the first
	  HttpClient request to a host name in a process waited 1-10+ s for proxy discovery (measured
	  2026-10-07; 33 ms with the proxy off), and a 10 s test bound failed on an idle machine. The
	  linked module initializer sets HttpClient.DefaultProxy to no proxy before any test runs.
	  Details: tests/Shared/NoSystemProxy.cs and docs/test-suite-performance-PRD.md §3, "No proxy in test processes".
	-->
	<ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<Compile Include="$(MSBuildThisFileDirectory)tests\Shared\NoSystemProxy.cs" Link="_Shared\NoSystemProxy.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Tests.txt" />
	</ItemGroup>
</Project>
