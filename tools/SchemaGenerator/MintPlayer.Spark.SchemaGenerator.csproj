<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Generates the JSON schemas of Spark's six hand-edited App_Data files (#264, G-Q11..Q13) from the
	  C# types the server deserializes them into, and writes them to schemas/ at the repository root.

	  The schemas are build artifacts (G-Q19): schemas/ is gitignored, and this repository's own
	  App_Data files point at it by relative path (G-Q20), so a pull request is validated against
	  the schemas of its own branch. The published, versioned copies are GitHub releases tagged
	  schemas/v{n}, made by the publish workflow (G-Q21).

	  Never packed: the generator is repository tooling, not part of any package.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<SparkSchemasDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'schemas'))</SparkSchemasDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
	</ItemGroup>

	<!--
	  Runs the generator after every build that changed it or a type it exports, so a fresh clone has
	  schemas/ after its first `dotnet build`. Incremental: an unchanged build skips the target
	  entirely (Inputs/Outputs), so it costs nothing on the common path. The output list names all
	  six files, so deleting one regenerates the set.

	  An Nx cache hit replays bin/ and obj/ without running MSBuild, so schemas/ can be missing after
	  one. Nothing depends on it being there except the editor: the guard tests generate in-process,
	  and CI runs the generator explicitly.
	-->
	<Target Name="GenerateSparkSchemas" AfterTargets="Build"
			Inputs="$(TargetPath);@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"
			Outputs="$(SparkSchemasDirectory)model.schema.json;$(SparkSchemasDirectory)security.schema.json;$(SparkSchemasDirectory)programUnits.schema.json;$(SparkSchemasDirectory)translations.schema.json;$(SparkSchemasDirectory)culture.schema.json;$(SparkSchemasDirectory)actions.schema.json">
		<PropertyGroup>
			<_SparkDotnetHost>$(DOTNET_HOST_PATH)</_SparkDotnetHost>
			<_SparkDotnetHost Condition="'$(_SparkDotnetHost)' == ''">dotnet</_SparkDotnetHost>
		</PropertyGroup>
		<!-- The trailing "." keeps the directory's closing separator from escaping the quote on Windows. -->
		<Exec Command="&quot;$(_SparkDotnetHost)&quot; exec &quot;$(TargetPath)&quot; &quot;$(SparkSchemasDirectory).&quot;" />
	</Target>

</Project>
