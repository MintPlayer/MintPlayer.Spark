<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Generates the JSON schemas of Spark's six hand-edited App_Data files (#264, G-Q11..Q13) from the
	  C# types the server deserializes them into, and writes them to schemas/ at the repository root.

	  The schemas are build artifacts (G-Q19): schemas/ is gitignored, and this repository's own
	  App_Data files point at it by relative path (G-Q20), so a pull request is validated against
	  the schemas of its own branch. The published, versioned copies are GitHub releases tagged
	  schemas/v{n}, made by the publish workflow (G-Q21).

	  Never packed: the generator is repository tooling, not part of any package.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- An Exe that is not a Spark application: opt out of the repo-wide Spark targets. -->
		<SparkApplication>false</SparkApplication>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- CultureFile and ActionsFileEntry live here, so their summaries become schema descriptions too. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<SparkSchemasDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'schemas'))</SparkSchemasDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\libs\spark\MintPlayer.Spark.Abstractions\MintPlayer.Spark.Abstractions.csproj" />
		<!--
		  The `contracts` command (commerce X20 item 2): the TypeScript contracts generator lives in MintPlayer.Spark (an
		  application's binary runs it too), and every library that declares [SparkContract] types is referenced here
		  so its types can be reflected over. SparkLibraryContracts.Libraries lists them.
		-->
		<ProjectReference Include="..\..\libs\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
		<ProjectReference Include="..\..\libs\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
		<ProjectReference Include="..\..\libs\refdata\abstractions\MintPlayer.Spark.ReferenceData.Abstractions.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce\MintPlayer.Spark.Commerce.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Payments\MintPlayer.Spark.Commerce.Payments.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Checkout\MintPlayer.Spark.Commerce.Checkout.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Promotions\MintPlayer.Spark.Commerce.Promotions.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Shipping\MintPlayer.Spark.Commerce.Shipping.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Ticketing.Venues\MintPlayer.Spark.Commerce.Ticketing.Venues.csproj" />
		<ProjectReference Include="..\..\libs\commerce\MintPlayer.Spark.Commerce.Ticketing.Events\MintPlayer.Spark.Commerce.Ticketing.Events.csproj" />
		<ProjectReference Include="..\..\libs\challenges\MintPlayer.Spark.Challenges\MintPlayer.Spark.Challenges.csproj" />
		<ProjectReference Include="..\..\libs\waiting_room\MintPlayer.Spark.WaitingRoom\MintPlayer.Spark.WaitingRoom.csproj" />
	</ItemGroup>

	<!--
	  Runs the generator after every build that changed it or a type it exports, so a fresh clone has
	  schemas/ after its first `dotnet build`. Incremental: an unchanged build skips the target
	  entirely (Inputs/Outputs), so it costs nothing on the common path. The output list names all
	  six files, so deleting one regenerates the set. The referenced projects' XML documentation files
	  are inputs too: a /// summary is a schema description, and editing one changes no reference assembly.

	  An Nx cache hit replays bin/ and obj/ without running MSBuild, so schemas/ can be missing after
	  one. Nothing depends on it being there except the editor: the guard tests generate in-process,
	  and CI runs the generator explicitly.
	-->
	<Target Name="GenerateSparkSchemas" AfterTargets="Build"
			Inputs="$(TargetPath);@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'));@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.xml'))"
			Outputs="$(SparkSchemasDirectory)model.schema.json;$(SparkSchemasDirectory)security.schema.json;$(SparkSchemasDirectory)programUnits.schema.json;$(SparkSchemasDirectory)translations.schema.json;$(SparkSchemasDirectory)culture.schema.json;$(SparkSchemasDirectory)actions.schema.json">
		<PropertyGroup>
			<_SparkDotnetHost>$(DOTNET_HOST_PATH)</_SparkDotnetHost>
			<_SparkDotnetHost Condition="'$(_SparkDotnetHost)' == ''">dotnet</_SparkDotnetHost>
		</PropertyGroup>
		<!-- The trailing "." keeps the directory's closing separator from escaping the quote on Windows. -->
		<Exec Command="&quot;$(_SparkDotnetHost)&quot; exec &quot;$(TargetPath)&quot; &quot;$(SparkSchemasDirectory).&quot;" />
	</Target>

</Project>
